#!/usr/bin/env python3
"""Regression coverage for codemap checks after release-note consumption."""

import contextlib
import importlib.util
import io
from pathlib import Path
import subprocess
import unittest
from unittest import mock

ROOT = Path(__file__).resolve().parent.parent
spec = importlib.util.spec_from_file_location("codemap_check", ROOT / "codemap/check.py")
checker = importlib.util.module_from_spec(spec)
spec.loader.exec_module(checker)


class ReleaseNotesOwnership(unittest.TestCase):
    def run_checker(self, exclude):
        run = subprocess.run

        def filtered_run(command, *args, **kwargs):
            result = run(command, *args, **kwargs)
            if command == ["git", "ls-files"]:
                paths = [p for p in result.stdout.splitlines() if not exclude(p)]
                result.stdout = "\n".join(paths) + "\n"
            return result

        checker.fails = 0
        output = io.StringIO()
        with mock.patch.object(checker.subprocess, "run", side_effect=filtered_run):
            with contextlib.redirect_stdout(output):
                status = checker.main()
        return status, output.getvalue()

    def test_consumed_release_notes(self):
        status, output = self.run_checker(lambda path: path.startswith(".changes/"))
        self.assertEqual(status, 0, output)

    def test_pending_release_notes(self):
        status, output = self.run_checker(lambda path: False)
        self.assertEqual(status, 0, output)

    def test_other_missing_owned_paths_still_fail(self):
        status, output = self.run_checker(lambda path: path == "LICENSE")
        self.assertEqual(status, 1, output)
        self.assertIn("glob 'LICENSE' matches no tracked file", output)


if __name__ == "__main__":
    unittest.main()
