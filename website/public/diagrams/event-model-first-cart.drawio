ractions"><mxGeometry x="160.0" y="30.0" width="250" height="130" as="geometry" /></mxCell><mxCell id="event-created" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:bold;letter-spacing:1px&quot;&gt;EVENT&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:bold;margin:8px 0 10px&quot;&gt;CartCreated&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.55&quot;&gt;entityId: c1&lt;br/&gt;ownerId: u1&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#172033;strokeWidth=1.5;fillColor=#FFEDD5;strokeColor=#EA580C;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="band-facts"><mxGeometry x="160.0" y="20.0" width="250" height="140" as="geometry" /></mxCell><mxCell id="read-empty" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:bold;letter-spacing:1px&quot;&gt;READ MODEL&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:bold;margin:8px 0 10px&quot;&gt;CartSummary&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:1.55&quot;&gt;cartSummaryId: c1&lt;br/&gt;ownerId: u1&lt;br/&gt;itemCount: 0&lt;br/&gt;isEmpty: true&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#172033;strokeWidth=1.5;fillColor=#DCFCE7;strokeColor=#15803D;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="band-interactions"><mxGeometry x="650.0" y="10.0" width="250" height="180" as="geometry" /></mxCell><mxCell id="screen-empty" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;div style=&quot;font-size:11px;color:#64748b;font-weight:bold&quot;&gt;ILLUSTRATIVE SCREEN&lt;/div&gt;&lt;div style=&quot;font-size:20px;font-weight:bold;margin:9px 0 12px&quot;&gt;Your cart · c1&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.5&quot;&gt;0 entries&lt;br/&gt;Your cart is empty.&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#172033;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#64748B;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="band-screens"><mxGeometry x="650.0" y="35.0" width="250" height="150" as="geometry" /></mxCell><mxCell id="screen-to-create" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endSize=8;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="canvas" source="screen-start" target="command-create"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="create-to-fact" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endSize=8;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="canvas" source="command-create" target="event-created"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fact-to-view" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endSize=8;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="canvas" source="event-created" target="read-empty"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="805" y="660" /></Array></mxGeometry></mxCell><mxCell id="view-to-screen" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endSize=8;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="canvas" source="read-empty" target="screen-empty"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="notes" value="c1 and u1 stand for generated cart and anonymous-owner UUIDs. The view is shown after it has caught up.&lt;br/&gt;The cards use public testbed names and fields; the screen design is a teaching example." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#172033;strokeWidth=1.5;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=0;fontColor=#475569;spacing=0;" vertex="1" parent="canvas"><mxGeometry x="40" y="865" width="940" height="45" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>