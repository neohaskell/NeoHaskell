<mxfile host="drawio" version="26.0.0"><diagram id="event-model-first-cart" name="A first event model: start a cart" source="https://eventmodeling.org/posts/what-is-event-modeling/ | https://www.nebulit.de/eventmodeling-tutorial/01-das-eventmodell | testbed/src/Testbed/Cart/Commands/CreateCart.hs | testbed/src/Testbed/Cart/Commands/AddItem.hs | testbed/src/Testbed/Cart/Core.hs | testbed/src/Testbed/Cart/Queries/CartSummary.hs"><mxGraphModel dx="1020" dy="930" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1020" pageHeight="930" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="canvas" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#172033;strokeWidth=1.5;container=1;pointerEvents=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1020" height="930" as="geometry" /></mxCell><mxCell id="title" value="A first event model: start a cart" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#172033;strokeWidth=1.5;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#172033;spacing=0;" vertex="1" parent="canvas"><mxGeometry x="40" y="25" width="940" height="40" as="geometry" /></mxCell><mxCell id="subtitle" value="Follow the same information from a person’s intention to a recorded fact and back to a screen." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#172033;strokeWidth=1.5;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;fontColor=#172033;spacing=0;" vertex="1" parent="canvas"><mxGeometry x="40" y="75" width="940" height="30" as="geometry" /></mxCell><mxCell id="band-screens" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#172033;strokeWidth=1.5;container=1;pointerEvents=0;fillCo