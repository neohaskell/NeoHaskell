---
import '../styles/landing.css';
import { landingContent } from '../data/landing';

const {
	eyebrow,
	headline,
	intro,
	primaryCta,
	secondaryCta,
	shift,
	history,
	model,
	slices,
	tools,
	audiences,
	closing,
} = landingContent;

const githubUrl = 'https://github.com/neohaskell/NeoHaskell';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#f6f1e8" />
		<meta name="description" content={intro} />
		<link rel="canonical" href="https://neohaskell.org/" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{headline[0]} {headline[1]} · NeoHaskell</title>
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="NeoHaskell" />
		<meta property="og:title" content={`${headline[0]} ${headline[1]}`} />
		<meta property="og:description" content={intro} />
		<meta property="og:url" content="https://neohaskell.org/" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={`${headline[0]} ${headline[1]}`} />
		<meta name="twitter:description" content={intro} />
	</head>
	<body class="landing-page">
		<a class="skip-link" href="#main-content">Skip to content</a>

		<header class="site-header">
			<div class="site-header__inner">
				<a class="wordmark" href="/" aria-label="NeoHaskell home">
					<span class="wordmark__mark" aria-hidden="true">N</span>
					<span class="wordmark__name">NeoHaskell</span>
				</a>
				<nav class="site-nav" aria-label="Primary navigation">
					<a href="/docs/">Docs</a>
					<a href="/getting-started/">Build</a>
					<a href="/start/fit-and-tradeoffs/">Fit &amp; tradeoffs</a>
					<a href={githubUrl} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
				</nav>
				<a class="button button--small button--ink site-header__cta" href={primaryCta.href}>{primaryCta.label}</a>
			</div>
		</header>

		<main id="main-content">
			<section class="hero" aria-labelledby="hero-title">
				<div class="page-shell hero__inner">
					<div class="hero__copy">
						<p class="eyebrow">{eyebrow}</p>
						<h1 id="hero-title" class="hero__title">
							<span>{headline[0]}</span>
							<span class="hero__title-accent">{headline[1]}</span>
						</h1>
						<p class="hero__intro">{intro}</p>
						<div class="hero__actions">
							<a class="button button--orange" href={primaryCta.href}>{primaryCta.label}<span aria-hidden="true">↗</span></a>
							<a class="text-link" href={secondaryCta.href}>{secondaryCta.label}<span aria-hidden="true">→</span></a>
						</div>
						<ul class="hero__stack" aria-label="NeoHaskell includes">
							<li>Haskell dialect</li>
							<li>Application framework</li>
							<li>Neo CLI + visual IDE</li>
						</ul>
					</div>

					<div class="hero-stage" aria-label="A NeoHaskell model connects an intent to an accepted event and a view">
						<div class="hero-stage__topline">
							<span class="hero-stage__status"><span class="status-dot" aria-hidden="true"></span> Shared model</span>
							<span class="hero-stage__index">01 / 04</span>
						</div>
						<div class="hero-stage__rule" aria-hidden="true"></div>
						<p class="hero-stage__title">A request becomes something you can explain.</p>
						<div class="hero-stage__opening-fact">
							<span>Starting fact</span>
							<strong>Account opened&nbsp; +€100</strong>
						</div>
						<div class="model-flow model-flow--hero">
							<div class="flow-node flow-node--command">
								<span class="flow-node__type">Command</span>
								<strong>Withdraw €30</strong>
								<small>an actor’s intent</small>
							</div>
							<span class="flow-arrow" aria-hidden="true">→</span>
							<div class="flow-node flow-node--decision">
								<span class="flow-node__type">Decision</span>
								<strong>Rules apply</strong>
								<small>accept or refuse</small>
							</div>
							<span class="flow-arrow" aria-hidden="true">→</span>
							<div class="flow-node flow-node--event">
								<span class="flow-node__type">Event</span>
								<strong>CashWithdrawn</strong>
								<small>a recorded fact</small>
							</div>
						</div>
						<div class="hero-stage__view">
							<span class="flow-node__type">Query / view</span>
							<strong>Current balance&nbsp; €70</strong>
							<span>the answer people can use</span>
						</div>
						<p class="hero-stage__caption">Intent passes through the domain before it changes the state.</p>
					</div>
				</div>
			</section>

			<section class="shift-section" id="philosophy" aria-labelledby="shift-title">
				<div class="page-shell section-shell shift-section__inner">
					<div class="section-heading section-heading--dark">
						<div>
							<p class="eyebrow">{shift.eyebrow}</p>
							<h2 id="shift-title">{shift.title}</h2>
						</div>
						<p class="section-heading__body">{shift.body}</p>
					</div>
					<div class="shift-compare" aria-label="The development bottleneck changes when code becomes abundant">
						<div class="shift-compare__row shift-compare__row--old">
							<span class="shift-compare__label">The old bottleneck</span>
							<strong>Turning a clear requirement into working syntax.</strong>
							<span class="shift-compare__mark" aria-hidden="true">01</span>
						</div>
						<div class="shift-compare__line" aria-hidden="true"><span></span></div>
						<div class="shift-compare__row shift-compare__row--new">
							<span class="shift-compare__label">The new bottleneck</span>
							<strong>Keeping rules, decisions, and consequences truthful as software changes.</strong>
							<span class="shift-compare__mark" aria-hidden="true">02</span>
						</div>
					</div>
				</div>
			</section>

			<section class="history-section" id="history" aria-labelledby="history-title">
				<div class="page-shell section-shell history-section__inner">
					<div class="section-heading">
						<div>
							<p class="eyebrow">{history.eyebrow}</p>
							<h2 id="history-title">{history.title}</h2>
						</div>
						<p class="section-heading__body">{history.body}</p>
					</div>

					<div class="history-layout">
						<figure class="history-ledger">
							<div class="history-ledger__head">
								<div>
									<span class="history-ledger__label">Current summary</span>
									<strong class="history-ledger__amount">€70</strong>
								</div>
								<span class="history-ledger__badge">read model</span>
							</div>
							<div class="history-ledger__calculation" aria-label="Current balance is calculated from one hundred euros minus thirty euros">
								<span>€100</span><span aria-hidden="true">−</span><span>€30</span><span aria-hidden="true">=</span><strong>€70</strong>
							</div>
							<details class="history-disclosure"><summary class="button button--ink history-ledger__toggle">
								<span>Explore the retained history</span><span aria-hidden="true">↓</span>
							</summary>
							<div class="history-trace" id="history-trace">
								<p class="history-trace__intro">The summary is useful because the facts behind it remain available.</p>
								<ol>
									<li>
										<span class="history-trace__number">01</span>
										<span><strong>Account opened</strong><small>+ €100</small></span>
									</li>
									<li>
										<span class="history-trace__number">02</span>
										<span><strong>Cash withdrawn</strong><small>− €30</small></span>
									</li>
									<li class="history-trace__result">
										<span class="history-trace__number">∑</span>
										<span><strong>Current balance</strong><small>€70</small></span>
									</li>
								</ol>
							</div>
							</details>
							<figcaption>{history.caption}</figcaption>
						</figure>

						<div class="history-notes">
							<p class="history-notes__lead">A current value can answer “what is it now?” History can also answer:</p>
							<ul class="question-list">
								<li><span>Why did it change?</span><strong>Inspect the event and its context.</strong></li>
								<li><span>What was true last Tuesday?</span><strong>Replay the facts up to that moment.</strong></li>
								<li><span>Can a new report use the same facts?</span><strong>Build another view from the history.</strong></li>
							</ul>
							<details class="correction-details">
								<summary><span>What if the withdrawal was recorded twice?</span><span aria-hidden="true">+</span></summary>
								<div class="correction-details__body">
									<p>A correction adds a new fact. It does not quietly rewrite the past.</p>
									<div class="correction-path" aria-label="An explicit correction path">
										<span class="correction-path__event">CashWithdrawn −€30</span>
										<span aria-hidden="true">→</span>
										<span class="correction-path__event correction-path__event--alert">DuplicateDetected</span>
										<span aria-hidden="true">→</span>
										<span class="correction-path__event correction-path__event--resolved">WithdrawalReversed +€30</span>
									</div>
									<p class="correction-details__note">You define how the application detects a duplicate and records the reversal. Neither is automatic.</p>
								</div>
							</details>
						</div>
					</div>
				</div>
			</section>

			<section class="model-section" id="model" aria-labelledby="model-title">
				<div class="page-shell section-shell">
					<div class="model-layout">
						<div class="model-copy">
							<p class="eyebrow">{model.eyebrow}</p>
							<h2 id="model-title">{model.title}</h2>
							<p class="model-copy__body">{model.body}</p>
							<div class="model-vocabulary" aria-label="NeoHaskell model vocabulary">
								<div class="vocabulary-item vocabulary-item--command"><span>Command</span><small>typed intent</small></div>
								<div class="vocabulary-item vocabulary-item--event"><span>Event</span><small>accepted fact</small></div>
								<div class="vocabulary-item vocabulary-item--view"><span>Query</span><small>useful view</small></div>
							</div>
						</div>
						<figure class="model-figure">
							<img src="/diagrams/meaning-to-software.svg" width="683" height="601" loading="lazy" decoding="async" alt="A shared model connects intent, a domain model, implementation with an agent, and evidence that a person can inspect." />
							<figcaption>One map for the conversation, the implementation, and the check that follows.</figcaption>
						</figure>
					</div>
				</div>
			</section>

			<section class="slices-section" id="slices" aria-labelledby="slices-title">
				<div class="page-shell section-shell">
					<div class="section-heading">
						<div>
							<p class="eyebrow">{slices.eyebrow}</p>
							<h2 id="slices-title">{slices.title}</h2>
						</div>
						<p class="section-heading__body">{slices.body}</p>
					</div>
					<div class="slice-rail" aria-label="A vertical slice from request to useful result">
						<div class="slice-step slice-step--command">
							<span class="slice-step__number">01</span>
							<strong>Request</strong>
							<span>what someone intends</span>
						</div>
						<div class="slice-step slice-step--decision">
							<span class="slice-step__number">02</span>
							<strong>Decision</strong>
							<span>which rules apply</span>
						</div>
						<div class="slice-step slice-step--event">
							<span class="slice-step__number">03</span>
							<strong>Event</strong>
							<span>what the system records</span>
						</div>
						<div class="slice-step slice-step--view">
							<span class="slice-step__number">04</span>
							<strong>View</strong>
							<span>what people can ask next</span>
						</div>
					</div>
					<p class="section-note">A slice is a bounded change a person or an agent can understand, test, and review.</p>
				</div>
			</section>

			<section class="tools-section" id="tools" aria-labelledby="tools-title">
				<div class="page-shell section-shell">
					<div class="tools-layout">
						<div class="tools-copy">
							<p class="eyebrow">{tools.eyebrow}</p>
							<h2 id="tools-title">{tools.title}</h2>
							<p class="tools-copy__body">{tools.body}</p>
							<ul class="tool-list">
								<li><span>01</span><strong>NeoHaskell</strong><small>A focused Haskell dialect for domain code.</small></li>
								<li><span>02</span><strong>Application framework</strong><small>Commands, Events, Entities, and Queries with clear homes.</small></li>
								<li><span>03</span><strong>Neo CLI + visual IDE</strong><small>Build, run, test, and see the model as it grows.</small></li>
							</ul>
						</div>
						<figure class="ide-figure">
							<div class="ide-figure__chrome"><span></span><span></span><span></span><em>neo ide / mug-shop</em></div>
							<button class="ide-figure__zoom-trigger" type="button" popovertarget="ide-dialog" aria-haspopup="dialog"><span>Expand image</span><span aria-hidden="true">↗</span></button>
							<img src="/screenshots/neo-ide-overview.png" width="1023" height="768" loading="lazy" decoding="async" alt="Neo IDE overview showing the mug-shop model with a CreateCart command, CartCreated event, and CartSummary query connected on a canvas." />
							<figcaption>Neo IDE keeps the business model visible while the implementation takes shape. <a href="/getting-started/visual-ide/">See the visual IDE guide <span aria-hidden="true">↗</span></a></figcaption>
						</figure>
					</div>
				</div>
			</section>

			<div popover="auto" role="dialog" class="ide-dialog" id="ide-dialog" aria-labelledby="ide-dialog-title">
				<div class="ide-dialog__surface">
					<div class="ide-dialog__head">
						<p id="ide-dialog-title">Neo IDE overview</p>
						<button class="ide-dialog__close" type="button" popovertarget="ide-dialog" popovertargetaction="hide" aria-label="Close enlarged Neo IDE image">×</button>
					</div>
					<img src="/screenshots/neo-ide-overview.png" width="1023" height="768" alt="Neo IDE overview showing the mug-shop model with a CreateCart command, CartCreated event, and CartSummary query connected on a canvas." />
					<p>Commands, Events, and Queries stay visible as one model while the application grows.</p>
				</div>
			</div>

			<section class="audiences-section" id="fit" aria-labelledby="audiences-title">
				<div class="page-shell section-shell">
					<div class="section-heading section-heading--audiences">
						<div>
							<p class="eyebrow">Choose your way in</p>
							<h2 id="audiences-title">Start with the question in front of you.</h2>
						</div>
						<p class="section-heading__body">NeoHaskell is for people who need software to stay discussable while it changes: domain experts, builders, and teams deciding what deserves a durable record.</p>
					</div>
					<div class="audience-list">
						{audiences.map((audience, index) => (
							<a class="audience-row" href={audience.href}>
								<span class="audience-row__index">0{index + 1}</span>
								<span class="audience-row__copy"><strong>{audience.title}</strong><span>{audience.body}</span></span>
								<span class="audience-row__link">{audience.label}<span aria-hidden="true">↗</span></span>
							</a>
						))}
					</div>
				</div>
			</section>

			<section class="closing-section" aria-labelledby="closing-title">
				<div class="page-shell section-shell closing-section__inner">
					<div>
						<p class="eyebrow">Keep the thread</p>
						<h2 id="closing-title">{closing.title}</h2>
						<p class="closing-section__body">{closing.body}</p>
						<a class="button button--ink" href={closing.href}>{closing.label}<span aria-hidden="true">↗</span></a>
					</div>
					<div class="closing-section__aside" aria-hidden="true">
						<span>meaning</span><span>→</span><span>model</span><span>→</span><span>software</span>
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="page-shell site-footer__inner">
				<a class="wordmark wordmark--footer" href="/" aria-label="NeoHaskell home">
					<span class="wordmark__mark" aria-hidden="true">N</span>
					<span class="wordmark__name">NeoHaskell</span>
				</a>
				<p>Understand the rules. Keep the history. Build with an agent.</p>
				<nav aria-label="Footer navigation">
					<a href="/docs/">Docs</a>
					<a href="/start/fit-and-tradeoffs/">Fit &amp; tradeoffs</a>
					<a href="/operate/contributing/">Contribute</a>
					<a href={githubUrl} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
				</nav>
			</div>
		</footer>

	</body>
</html>
