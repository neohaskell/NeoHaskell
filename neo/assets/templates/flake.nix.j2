{
  description = "{{ description | default(name) }}";

  inputs.haskellNix.url = "github:input-output-hk/haskell.nix";
  inputs.nixpkgs.follows = "haskellNix/nixpkgs-unstable";
  inputs.flake-utils.url = "github:numtide/flake-utils";

{% if neohaskell_source %}  inputs.neohaskell.url = "{{ neohaskell_source }}";
{% else %}  inputs.neohaskell.url = "git+https://github.com/neohaskell/neohaskell.git?rev={{ neo_sha }}";
{% endif %}  inputs.neohaskell.flake = false;

  outputs = { self, nixpkgs, flake-utils, haskellNix, neohaskell }:
    let
      supportedSystems =
        [ "x86_64-linux" "x86_64-darwin" "aarch64-linux" "aarch64-darwin" ];

      neohaskellCommit = "{{ neohaskell_commit }}";

    in flake-utils.lib.eachSystem supportedSystems (system:
      let
        overlays = [
          haskellNix.overlay
          (final: _prev: {
            hixProject = final.haskell-nix.hix.project {
              src = ./.;

              inputMap = {
                "{{ neohaskell_git_url }}/${neohaskellCommit}" = neohaskell;
              };
              shell.buildInputs = with final; [
                hurl
                postgresql
                libpq
                zlib
                pkg-config
              ];
            };
          })
        ];
        pkgs = import nixpkgs {
          inherit system overlays;
          inherit (haskellNix) config;
        };
        project = pkgs.hixProject;
        toolchainFile = neohaskell + "/neo/starter/nix/toolchain.nix";
        toolchain = import toolchainFile {
          inherit pkgs;
          frameworkSource = neohaskell;
          frameworkRevision = neohaskellCommit;
        };
        starterLock = builtins.fromJSON
          (builtins.readFile (neohaskell + "/neo/starter/flake.lock"));
        starterInputs = starterLock.nodes.${starterLock.root}.inputs;
        starterHaskellNix = starterLock.nodes.${starterInputs.haskellNix};
        starterNixpkgs = starterLock.nodes.${starterHaskellNix.inputs.nixpkgs-unstable};
        usesSharedTools =
          system != "x86_64-darwin"
          && builtins.pathExists toolchainFile
          && (haskellNix.rev or null) == starterHaskellNix.locked.rev
          && (nixpkgs.rev or null) == starterNixpkgs.locked.rev
          && project.args.compiler-nix-name == toolchain.compiler
          && (project.args.ghcOverride or null) == null
          && (project.args.ghc or null) == null
          && pkgs.lib.all (tool: (project.args.shell.tools.${tool} or null)
            == toolchain.toolVersions.${tool}) (builtins.attrNames toolchain.toolVersions);
        shellProject = if usesSharedTools then project.appendModule {
          shell.withHoogle = pkgs.lib.mkDefault false;
          shell.nativeBuildInputs = [ toolchain.editorTools toolchain.hoogle ];
        } else project;
        flake = shellProject.flake { };
      in flake // {
        legacyPackages = pkgs;
        neoToolchains = if usesSharedTools then {
          storePath = toolchain.bundle.outPath;
          frameworkRevision = neohaskellCommit;
        } else null;
        packages = flake.packages // pkgs.lib.optionalAttrs usesSharedTools {
          neo-toolchain = toolchain.bundle;
        };
      });

  nixConfig = {
    extra-substituters = [
      "https://cache.iog.io"
      "https://neohaskell.cachix.org"
    ];
    extra-trusted-public-keys = [
      "hydra.iohk.io:f/Ea+s+dFdN+3Y/G+FDgSq+a5NEWhJGzdjvKNGv0/EQ="
      "neohaskell.cachix.org-1:mo2cLaGbwqbrxs9xhqKK8jeNsn3osi7t6XoAmxSZssc="
    ];
    allow-import-from-derivation = "true";
  };
}
