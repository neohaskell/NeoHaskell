cabal-version: 3.4
name: {{ name }}
version: {{ version }}
{% if description %}description: {{ description }}{% endif %}
homepage: https://neohaskell.org
license: {{ license }}
author: {{ author }}
category: Development
build-type: Simple

{% if not is_library %}
flag event-model-launcher
  description: Event Model launcher supplied by the resolved framework version.
  default: True
  manual: False

{% endif %}
common common_cfg
  ghc-options:
    -Wall
    -Wno-orphans
    -threaded
    -fno-warn-partial-type-signatures
    -fno-warn-name-shadowing
    -Werror

  default-extensions:
    ApplicativeDo
    BlockArguments
    DataKinds
    DeriveDataTypeable
    DerivingStrategies
    DuplicateRecordFields
    ImportQualifiedPost
    ImpredicativeTypes
    NamedFieldPuns
    NoFieldSelectors
    NoImplicitPrelude
    OverloadedLabels
    OverloadedLists
    OverloadedRecordDot
    OverloadedStrings
    PackageImports
    PartialTypeSignatures
    QualifiedDo
    QuasiQuotes
    Strict
    TemplateHaskell
    TypeApplications
    TypeFamilies
    TypeOperators

  build-depends:
    base,
    nhcore,
    nhintegrations,
    aeson,
    bytestring,
    text,
    uuid
{% for dep, ver in dependencies %}
    , {{ dep }} {{ ver }}
{% endfor %}

library
  import: common_cfg
  exposed-modules:
{% for module in modules %}
    {{ module }}
{% endfor %}
  hs-source-dirs: src
  default-language: GHC2021

{% if not is_library %}
executable {{ name }}
  import: common_cfg
  main-is: Launcher.hs
  autogen-modules: {{ paths_module }}
  other-modules: {{ paths_module }}
  if flag(event-model-launcher)
    build-depends: nhcore:launcher
    cpp-options: -DNHCORE_EVENT_MODEL_LAUNCHER
  build-depends:
    base,
    {{ name }}
  hs-source-dirs: launcher
  default-language: GHC2021
{% endif %}

test-suite {{ name }}-test
  import: common_cfg
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: tests

  build-depends:
    base,
    {{ name }},
    hspec,
    QuickCheck,
    quickcheck-instances
{% if test_modules %}
  other-modules:
{% for module in test_modules %}
    {{ module }}
{% endfor %}
{% endif %}
  default-language: GHC2021
  ghc-options:
    -rtsopts
    -with-rtsopts=-N
