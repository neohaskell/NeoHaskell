packages:
  *.cabal

source-repository-package
  type: git
  location: {{ neohaskell_git_url }}
  tag: {{ neohaskell_commit }}
  subdir: core

source-repository-package
  type: git
  location: {{ neohaskell_git_url }}
  tag: {{ neohaskell_commit }}
  subdir: integrations

{% for dep in git_dependencies %}
source-repository-package
    type: git
    location: {{ dep.url }}
    tag: {{ dep.rev }}
{% endfor %}
{% for dep in file_dependencies %}
packages: {{ dep.path }}
{% endfor %}

constraints:
  hasql < 1.10,
  opt-env-conf < 0.11

package {{ name }}
  tests: True
