packages:
  *.cabal

-- NeoHaskell core library
-- The git source is managed by flake.nix inputMap (nix flake update to update)
-- IMPORTANT: Use specific commit SHA, not branch name, for reproducible builds
-- To update: 1) nix flake lock --update-input neohaskell
--            2) Update the tag below to match: nix eval .#neohaskell.rev --raw
source-repository-package
  type: git
  location: {{ neohaskell_git_url }}
  tag: {{ neohaskell_commit }}
  subdir: core


-- NeoHaskell integrations (OpenRouter, HTTP, etc.)
source-repository-package
  type: git
  location: {{ neohaskell_git_url }}
  tag: {{ neohaskell_commit }}
  subdir: integrations

{% for dep in git_dependencies %}
source-repository-package
    type: git
    location: {{ dep.url }}
    tag: {{ dep.rev }}
{% endfor %}
{% for dep in file_dependencies %}
packages: {{ dep.path }}
{% endfor %}

-- Version upper-bounds needed for compatibility with NeoHaskell core.
-- haskell.nix pins the Hackage snapshot, but these prevent picking API-breaking
-- versions that post-date the NeoHaskell core code at the pinned commit.
constraints:
  hasql < 1.10,
  opt-env-conf < 0.11

-- Build this project's own test-suite as part of the plan so `cabal test all`
-- resolves hspec / QuickCheck / quickcheck-instances from the pinned haskell.nix
-- snapshot without needing a live Hackage index. Every NeoCLI project ships a
-- test-suite by default, so this is always enabled. Scoped to this package so the
-- source-repository-package deps (nhcore, nhintegrations) do NOT build their own
-- (heavy, postgres-dependent) test-suites.
package {{ name }}
  tests: True
