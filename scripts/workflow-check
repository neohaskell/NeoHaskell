#!/usr/bin/env python3
"""Static wiring checks for the root GitHub workflows (pure stdlib, no nix).

Two contracts, both learned from real breakage:

  1. Hidden-artifact upload (root cause of nightly-bench run 29894978953):
     `actions/upload-artifact` excludes dotfiles by default, so uploading a
     hidden path (e.g. `.bench-results.json`) silently produced an empty
     artifact. Any upload step whose `path:` is hidden MUST set
     `include-hidden-files: true`.

  2. retrospect.yml wiring (Phase 6 learning loop, deterministic half):
     the automated digest must stay deterministic and side-effect-free — it
     runs `./dev retrospect`, publishes to the step summary + an artifact,
     is schedule- AND dispatch-triggered, and must NOT push/commit, invoke the
     LLM miner, or write recommendations.

  3. Haskell required gate (test.yml): scoped PRs stage on
     `integration/neo-monorepo` before the final merge to `main`, so the required
     Test gate must trigger on PRs whose base is EITHER of those branches, and
     its changed-path classifier must keep counting the Haskell compiled surfaces
     (core/, testbed/, integrations/) so a real code change can never read
     compiled=false and let ci-gate accept a green no-op skip.

  5. Generated-project consumer contract (neo-ci.yml): the neo component gate
     also carries ONE blocking end-to-end job (`consumer-contract`) that proves
     the Nix-packaged `neo` generates a project from the embedded starter and
     that the generated project builds/tests/runs/answers /health against the
     monorepo checkout under test. It is unreviewable-by-eye that this job stays
     (a) present, (b) blocking (never continue-on-error / report-only), (c) on
     Linux, (d) required through neo-ci-gate, and (e) triggered for every
     relevant surface (neo/, core/, integrations/). This freezes all five so a
     regression that silently removes, weakens, or de-scopes the contract fails
     loudly.

  4. Neo CLI component gate (neo-ci.yml): now that neo has its own crate CI, the
     Neo CLI is gated by neo-ci.yml, NOT by the Haskell Test gate (test.yml no
     longer classifies neo/** as compiled; see contract 3). Two invariants keep
     that gate honest: (a) it must run on ARBITRARY PR bases (no base-branch
     allowlist) because neo ships through official stacked PRs whose base is
     whatever lower stack layer they sit on, so an allowlist would silently stop
     gating neo the moment it stacks on a new branch; and (b) its changed-path
     classifier must route neo/** to the component jobs. This freezes both so a
     regression to a main/integration-only filter, or a dropped neo/** route,
     fails loudly.

Run:  ./dev workflow-check          CI: .github/workflows/checks.yml
      ./dev workflow-check --self-test   (doctor/CI)
"""

import re
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
WORKFLOWS = REPO_ROOT / ".github" / "workflows"

UPLOAD_RE = re.compile(r"uses:\s*actions/upload-artifact")

# The Haskell required merge gate + the base branches it must cover, and the
# surfaces its changed-path classifier must treat as compiled. See contract 3.
REQUIRED_GATE = "test.yml"
GATE_BASE_BRANCHES = ("main", "integration/neo-monorepo")
COMPILED_SURFACES = ("core/", "testbed/", "integrations/")

# The Neo CLI component gate + the surface its classifier must route. See
# contract 4. It intentionally has NO base-branch allowlist (stacked PRs).
COMPONENT_GATE = "neo-ci.yml"
COMPONENT_SURFACES = ("neo/",)

# The generated-project consumer-contract job (contract 5) + the surfaces its
# broader classifier must route. It covers the component surfaces PLUS the
# monorepo Haskell sources the generated project compiles against, because a
# change there can break the starter->upstream contract.
CONSUMER_CONTRACT_JOB = "consumer-contract"
CONTRACT_GATE_JOB = "neo-ci-gate"
CONTRACT_SURFACES = ("neo/", "core/", "integrations/")
CONTRACT_VERB = "neo-consumer-contract"


def _indent(line):
    return len(line) - len(line.lstrip(" "))


def upload_steps(text):
    """Each `actions/upload-artifact` step as {paths: [...], include_hidden: bool}.

    Block boundaries are indentation-based: a step owns every following line
    indented deeper than its `- uses:` line.
    """
    lines = text.splitlines()
    steps = []
    i = 0
    while i < len(lines):
        if not UPLOAD_RE.search(lines[i]):
            i += 1
            continue
        base = _indent(lines[i])
        block = []
        j = i + 1
        while j < len(lines):
            if lines[j].strip() and _indent(lines[j]) <= base:
                break
            block.append(lines[j])
            j += 1
        steps.append({"paths": _paths(block),
                      "include_hidden": _include_hidden(block)})
        i = j
    return steps


def _include_hidden(block):
    return any(re.match(r"\s*include-hidden-files:\s*true\b", ln) for ln in block)


def _paths(block):
    paths = []
    for k, ln in enumerate(block):
        m = re.match(r"(\s*)path:\s*(.*)$", ln)
        if not m:
            continue
        indent, value = len(m.group(1)), m.group(2).strip()
        if value in ("|", ">", "|-", ">-", "|+", ">+", ""):
            # block scalar / list: gather the deeper-indented entries
            for follow in block[k + 1:]:
                if follow.strip() and _indent(follow) <= indent:
                    break
                entry = follow.strip().lstrip("- ").strip()
                if entry:
                    paths.append(entry)
        else:
            paths.append(value)
    return paths


def is_hidden_path(path):
    """A path is hidden if any real component starts with '.' (not . or ..)."""
    for part in path.split("/"):
        if part.startswith(".") and part not in (".", ".."):
            return True
    return False


def check_hidden_artifacts(name, text):
    errs = []
    for step in upload_steps(text):
        for p in step["paths"]:
            if is_hidden_path(p) and not step["include_hidden"]:
                errs.append(
                    f"{name}: uploads hidden path '{p}' without "
                    "`include-hidden-files: true` (artifact would be empty)")
    return errs


def strip_comments(text):
    """Drop YAML comments so banned-token scans see executable content only —
    the workflow's own docstring-comments legitimately name what it must NOT do."""
    out = []
    for line in text.splitlines():
        if line.lstrip().startswith("#"):
            continue
        # trailing ` # comment` (heuristic: space-hash outside quotes is rare here)
        if " #" in line:
            line = line[:line.index(" #")]
        out.append(line)
    return "\n".join(out)


def check_retrospect(name, text):
    errs = []
    required = {
        "schedule:": "no `schedule:` trigger (weekly review input)",
        "workflow_dispatch:": "no `workflow_dispatch:` trigger (on-demand parity)",
        "./dev retrospect": "does not run `./dev retrospect`",
        "GITHUB_STEP_SUMMARY": "does not publish to the GitHub step summary",
        "upload-artifact": "does not upload the digest as an artifact",
    }
    for needle, why in required.items():
        if needle not in text:
            errs.append(f"{name}: {why}")
    code = strip_comments(text)
    # No direct pushes / commits — this loop is report-only.
    for banned in ("git push", "git commit", "git -C", "peter-evans/create-pull-request"):
        if banned in code:
            errs.append(f"{name}: must not push/commit ('{banned}' present) — the "
                        "loop is report-only")
    # Must not pretend to run the miner or fabricate recommendations.
    for banned in ("recommendations.jsonl", "retrospect --record",
                   "retrospective-miner", "--record"):
        if banned in code:
            errs.append(f"{name}: must not invoke the miner / write recommendations "
                        f"('{banned}' present) — that is a human/agent action")
    return errs


# ── codemap-regen.yml: maintainer codemap-regeneration security contract ──────
# (ADR-0070) The trust boundary and no-fallback behavior are load-bearing and
# unreviewable in YAML by eye — assert them statically. Criteria C2/C3/C7.
CODEMAP_REGEN = "codemap-regen.yml"
_SHA40 = re.compile(r"@[0-9a-f]{40}\b")
_PUBLISH_TOKEN = "CODEMAP_PUBLISH_TOKEN"


def _on_block(text):
    """The `on:` block text (trigger list), for trigger assertions."""
    lines = text.splitlines()
    out, capturing = [], False
    for ln in lines:
        if re.match(r"^on:\s*$", ln):
            capturing = True
            continue
        if capturing:
            if ln and not ln.startswith((" ", "\t")):
                break
            out.append(ln)
    return "\n".join(out)


def job_blocks(text):
    """Map each top-level job name under `jobs:` to its block text
    (indentation-delimited), so per-job assertions don't bleed across jobs."""
    lines = text.splitlines()
    blocks, cur, buf, in_jobs = {}, None, [], False
    for ln in lines:
        if re.match(r"^jobs:\s*$", ln):
            in_jobs = True
            continue
        if not in_jobs:
            continue
        m = re.match(r"^  ([A-Za-z0-9_-]+):\s*$", ln)
        if m:
            if cur is not None:
                blocks[cur] = "\n".join(buf)
            cur, buf = m.group(1), []
            continue
        if ln and not ln.startswith(" "):
            break
        buf.append(ln)
    if cur is not None:
        blocks[cur] = "\n".join(buf)
    return blocks


def _on_trigger_keys(on_block):
    """Top-level trigger keys under `on:` (the 2-space-indented `key:` lines)."""
    return [m.group(1) for m in re.finditer(r"^  ([a-z_]+):", on_block, re.M)]


# A `secrets` context reference, PROPERTY (`secrets.X`) or INDEX
# (`secrets['X']` / `secrets[env.NAME]`) — the index form dodges a `secrets.`
# substring scan, so both are rejected.
_SECRETS_REF = re.compile(r"secrets\s*[.\[]")


def check_codemap_regen(name, text):
    """Static security contract for the maintainer codemap-regeneration workflow.

    ALL checks run against comment-stripped content (`code` and the
    comment-stripped job blocks), so a control can neither be spoofed by a
    comment (a required marker present only in a comment) nor a forbidden token
    hidden as prose. The SOLE exception is the mandatory main-only Environment
    policy, which is documentation and therefore checked against raw `text`."""
    errs = []
    E = errs.append
    code = strip_comments(text)
    on = _on_block(code)
    jobs = job_blocks(code)
    gen, pub, res = jobs.get("generate", ""), jobs.get("publish", ""), jobs.get("resolve", "")

    # 1. manual dispatch ONLY — workflow_dispatch present and the only trigger.
    triggers = _on_trigger_keys(on)
    if "workflow_dispatch" not in triggers:
        E(f"{name}: no workflow_dispatch trigger (must be manual dispatch)")
    extra = sorted(set(triggers) - {"workflow_dispatch"})
    if extra:
        E(f"{name}: `on:` has non-manual trigger(s) {extra} — workflow_dispatch only "
          "(no pull_request/pull_request_target/push/schedule auto-trigger)")
    # 2. every third-party action pinned by full commit SHA.
    for m in re.finditer(r"uses:\s*(\S+)", code):
        ref = m.group(1)
        if ref.startswith(("./", "docker://")):
            continue
        if not _SHA40.search(ref):
            E(f"{name}: action '{ref}' is not pinned by a full 40-char commit SHA")
    # 3. no fallback PR anywhere.
    for banned in ("gh pr create", "create-pull-request"):
        if banned in code:
            E(f"{name}: opens a fallback PR ('{banned}') — forbidden (fail closed)")
    # 4. all three jobs present, and the untrusted/publish jobs DEPEND on the
    #    trusted resolve job — else the pinned PR metadata is never enforced.
    if not gen:
        E(f"{name}: missing `generate` job")
    if not pub:
        E(f"{name}: missing `publish` job")
    if not res:
        E(f"{name}: missing `resolve` job (pins the exact PR head + editability)")
    if gen and not re.search(r"^    needs:.*\bresolve\b", gen, re.M):
        E(f"{name}: generate job must `needs: resolve` (consume the pinned head)")
    if pub and not re.search(r"^    needs:.*\bresolve\b", pub, re.M):
        E(f"{name}: publish job must `needs: resolve` (consume the pinned head)")
    if pub and not re.search(r"^    needs:.*\bgenerate\b", pub, re.M):
        E(f"{name}: publish job must `needs: generate` (consume generated artifacts)")
    # 5. generate is untrusted: contents:read and NO secret (property OR index).
    gen_permissions = re.search(
        r"^    permissions:\s*\n((?:^      [^\n]*\n?)*)", gen, re.M)
    permission_lines = (
        [line.strip() for line in gen_permissions.group(1).splitlines() if line.strip()]
        if gen_permissions else []
    )
    if permission_lines != ["contents: read"]:
        E(f"{name}: generate job is not `contents: read`-only")
    if _SECRETS_REF.search(gen):
        E(f"{name}: generate job references a secret (secrets.X or secrets['X']) "
          "— it must hold none")
    # 6. the publish token is isolated to publish, which is Environment-gated.
    if _PUBLISH_TOKEN in gen or _PUBLISH_TOKEN in res:
        E(f"{name}: {_PUBLISH_TOKEN} is exposed outside the publish job")
    if _PUBLISH_TOKEN not in pub:
        E(f"{name}: publish job does not use {_PUBLISH_TOKEN}")
    if not re.search(r"^    environment:\s*codemap-publish\s*$", pub, re.M):
        E(f"{name}: publish job is not gated by the codemap-publish Environment")
    # 7. runtime main-ref guard (defense in depth).
    if "refs/heads/main" not in pub:
        E(f"{name}: publish job lacks a runtime main-ref guard")
    # 8. documented mandatory main-only policy — the ONE raw-text check (it is
    #    documentation, deliberately a comment).
    if "Deployment branches" not in text:
        E(f"{name}: does not document the mandatory codemap-publish main-only "
          "deployment-branch policy (the load-bearing secret guard)")
    # 9. publish runs NO contributor/build code.
    for banned in ("./dev ", "nix develop", "cabal ", "make "):
        if banned in pub:
            E(f"{name}: publish job runs '{banned.strip()}' — it must execute no "
              "contributor or build code")
    # 10. every publish checkout is credential-less.
    n_checkout = len(re.findall(r"uses:\s*actions/checkout", pub))
    n_nopersist = len(re.findall(r"persist-credentials:\s*false", pub))
    if n_nopersist < n_checkout:
        E(f"{name}: a publish checkout does not set persist-credentials: false")
    # 11. fast-forward only, ephemeral auth.
    if re.search(r"--force|force-with-lease|push\s+-f\b|push[^\n]*\s\+\S", pub):
        E(f"{name}: publish force-pushes — must be fast-forward only")
    if "http.extraHeader" not in pub:
        E(f"{name}: publish does not use ephemeral http.extraHeader auth "
          "(token must not persist in a remote URL)")
    return errs


def pull_request_branches(text):
    """The `branches:` list under the `on: pull_request:` block, or None if the
    trigger has no branch filter (runs on every base). Handles both the block
    form (`branches:` then `- x` lines) and the inline form (`branches: [x, y]`).
    """
    lines = text.splitlines()
    for i, ln in enumerate(lines):
        if not re.match(r"^\s+pull_request:\s*$", ln):
            continue
        base = _indent(ln)
        j = i + 1
        while j < len(lines):
            cur = lines[j]
            if cur.strip() and _indent(cur) <= base:
                break  # left the pull_request block without finding branches:
            bm = re.match(r"(\s*)branches:\s*(.*)$", cur)
            if bm:
                inline = bm.group(2).strip()
                if inline.startswith("["):
                    return [x.strip() for x in inline.strip("[]").split(",") if x.strip()]
                if inline and inline not in ("|", ">", "|-", ">-"):
                    return [inline]
                bind = _indent(cur)
                items = []
                k = j + 1
                while k < len(lines):
                    nxt = lines[k]
                    if nxt.strip() and _indent(nxt) <= bind:
                        break
                    dm = re.match(r"\s*-\s*(\S.*?)\s*$", nxt)
                    if dm:
                        items.append(dm.group(1).strip())
                    k += 1
                return items
            j += 1
        return None
    return None


def classifier_pattern(text):
    """The changed-path classifier regex in the `changes` job (PATTERN='…')."""
    m = re.search(r"PATTERN='([^']*)'", text)
    return m.group(1) if m else None


def contract_classifier_pattern(text):
    """The broader consumer-contract classifier regex (CONTRACT='…') in the
    `changes` job — routes the surfaces that trigger the end-to-end contract."""
    m = re.search(r"CONTRACT='([^']*)'", text)
    return m.group(1) if m else None


def check_required_gate(name, text):
    """test.yml is the required merge gate. Two bootstrap invariants (contract 3):
    it must trigger on PRs to every GATE_BASE_BRANCHES base, and its classifier
    must count every COMPILED_SURFACES entry as compiled so neo work can't slip
    through a no-op skip."""
    errs = []
    prb = pull_request_branches(text)
    if prb is None:
        errs.append(f"{name}: no `on: pull_request: branches:` filter — cannot "
                    "confirm the required gate targets "
                    f"{', '.join(GATE_BASE_BRANCHES)}")
    else:
        for req in GATE_BASE_BRANCHES:
            if req not in prb:
                errs.append(f"{name}: pull_request does not target '{req}' — the "
                            "required Test gate would never run on PRs based on it")
    pat = classifier_pattern(text)
    if pat is None:
        errs.append(f"{name}: no changed-path classifier (PATTERN='…') found — "
                    "cannot confirm neo/** classifies as compiled")
    else:
        for surface in COMPILED_SURFACES:
            if surface not in pat:
                errs.append(
                    f"{name}: changed-path classifier lacks '{surface}' — a "
                    f"'{surface}'-only PR reads compiled=false and ci-gate accepts "
                    "every skip (a green no-op gate that claims it was tested)")
    return errs


def check_component_gate(name, text):
    """neo-ci.yml is the Neo CLI component gate (contract 4). It must run on
    ARBITRARY PR bases (no base-branch allowlist, so stacked layers on any branch
    stay gated) and its changed-path classifier must route every
    COMPONENT_SURFACES entry to the component jobs."""
    errs = []
    prb = pull_request_branches(text)
    if prb is not None:
        errs.append(
            f"{name}: pull_request has a `branches:` allowlist ({', '.join(prb)}) "
            "the component gate must run on EVERY stacked-PR base, not only "
            "named branches. Drop the filter and diff-scope in the `changes` job.")
    pat = classifier_pattern(text)
    if pat is None:
        errs.append(f"{name}: no changed-path classifier (PATTERN='...') found: "
                    "cannot confirm neo/** routes to the component jobs")
    else:
        for surface in COMPONENT_SURFACES:
            if surface not in pat:
                errs.append(
                    f"{name}: changed-path classifier lacks '{surface}': a "
                    f"'{surface}' change would not trigger the component jobs")
    return errs


def check_consumer_contract(name, text):
    """The generated-project consumer contract (contract 5) is one blocking
    end-to-end job in the neo component gate. Freeze five invariants so it cannot
    be silently removed, weakened to report-only, moved off Linux, decoupled from
    the required gate, or de-scoped for a relevant surface."""
    errs = []
    E = errs.append
    jobs = job_blocks(text)
    job = jobs.get(CONSUMER_CONTRACT_JOB, "")
    gate = jobs.get(CONTRACT_GATE_JOB, "")

    # (a) present.
    if not job:
        E(f"{name}: missing the `{CONSUMER_CONTRACT_JOB}` job (the end-to-end "
          "generated-project contract) — it must run in the neo component gate")
        return errs  # nothing else is checkable without the job

    # (b) blocking — never report-only.
    if re.search(r"continue-on-error:\s*true", job):
        E(f"{name}: `{CONSUMER_CONTRACT_JOB}` sets continue-on-error: true — the "
          "contract is a blocking gate, not report-only")

    # (c) on Linux.
    if not re.search(r"runs-on:\s*ubuntu", job):
        E(f"{name}: `{CONSUMER_CONTRACT_JOB}` does not run on Linux (runs-on: ubuntu-*)")

    # The contract clones the checkout into a git+file Nix input. Nix rejects a
    # local input inherited from actions/checkout's default shallow clone.
    if not re.search(r"uses:\s*actions/checkout[^\n]*\n\s+with:\s*\n\s+fetch-depth:\s*0", job):
        E(f"{name}: `{CONSUMER_CONTRACT_JOB}` checkout must set `fetch-depth: 0` "
          "— its local git+file Nix input cannot be shallow")

    # It actually runs the contract: both the orchestration self-test and the
    # full contract (a bare `./dev neo-consumer-contract`, not only --self-test).
    if f"{CONTRACT_VERB} --self-test" not in job:
        E(f"{name}: `{CONSUMER_CONTRACT_JOB}` never runs `./dev {CONTRACT_VERB} "
          "--self-test` (the orchestration-logic self-test)")
    if not re.search(rf"\./dev {re.escape(CONTRACT_VERB)}\s*$", job, re.M):
        E(f"{name}: `{CONSUMER_CONTRACT_JOB}` never runs the FULL contract "
          f"(`./dev {CONTRACT_VERB}` with no flags) — a self-test-only job would "
          "not prove a generated project builds/tests/runs")

    # It is triggered by real change detection, not always-on/decoupled: the job
    # must gate on the `contract` surface signal.
    if "contract == 'true'" not in job:
        E(f"{name}: `{CONSUMER_CONTRACT_JOB}` is not gated on "
          "`needs.changes.outputs.contract == 'true'` — it must run exactly when a "
          "relevant surface changed (not always, not never)")

    # (d) required through neo-ci-gate: the gate must both `needs` it and evaluate
    #     its result, so a skip/failure is enforced rather than ignored.
    if not gate:
        E(f"{name}: missing the `{CONTRACT_GATE_JOB}` required gate")
    else:
        if not re.search(rf"^    needs:.*\b{re.escape(CONSUMER_CONTRACT_JOB)}\b", gate, re.M):
            E(f"{name}: `{CONTRACT_GATE_JOB}` does not `needs: {CONSUMER_CONTRACT_JOB}` "
              "— the contract would not block the required gate")
        if f"needs.{CONSUMER_CONTRACT_JOB}.result" not in gate:
            E(f"{name}: `{CONTRACT_GATE_JOB}` never evaluates "
              f"`needs.{CONSUMER_CONTRACT_JOB}.result` — a contract failure/skip "
              "would pass unnoticed")

    # (e) routed for every relevant surface via the broader CONTRACT classifier.
    pat = contract_classifier_pattern(text)
    if pat is None:
        E(f"{name}: no consumer-contract classifier (CONTRACT='...') found — cannot "
          "confirm the contract runs for the relevant surfaces")
    else:
        for surface in CONTRACT_SURFACES:
            if surface not in pat:
                E(f"{name}: consumer-contract classifier lacks '{surface}' — a "
                  f"'{surface}' change would not trigger the end-to-end contract "
                  "(the starter->upstream break it exists to catch)")
    return errs


def run(root=WORKFLOWS):
    errs = []
    for wf in sorted(root.glob("*.yml")):
        text = wf.read_text(encoding="utf-8")
        errs += check_hidden_artifacts(wf.name, text)
        if wf.name == "retrospect.yml":
            errs += check_retrospect(wf.name, text)
        if wf.name == CODEMAP_REGEN:
            errs += check_codemap_regen(wf.name, text)
        if wf.name == REQUIRED_GATE:
            errs += check_required_gate(wf.name, text)
        if wf.name == COMPONENT_GATE:
            errs += check_component_gate(wf.name, text)
            errs += check_consumer_contract(wf.name, text)
    retro = root / "retrospect.yml"
    if not retro.exists():
        errs.append("retrospect.yml is missing (deterministic learning-loop digest)")
    if not (root / CODEMAP_REGEN).exists():
        errs.append(f"{CODEMAP_REGEN} is missing (maintainer codemap-regeneration capability)")
    gate = root / REQUIRED_GATE
    if not gate.exists():
        errs.append(f"{REQUIRED_GATE} is missing (the required Test merge gate)")
    component = root / COMPONENT_GATE
    if not component.exists():
        errs.append(f"{COMPONENT_GATE} is missing (the Neo CLI component gate)")
    return errs


def self_test():
    ok = True

    def check(name, cond):
        nonlocal ok
        print(f"  {'ok  ' if cond else 'FAIL'} {name}")
        ok = ok and cond

    hidden_bad = (
        "      - uses: actions/upload-artifact@v7\n"
        "        with:\n"
        "          name: r\n"
        "          path: .bench-results.json\n"
        "          retention-days: 90\n"
    )
    check("hidden path without opt-in is flagged",
          check_hidden_artifacts("f.yml", hidden_bad))

    hidden_ok = hidden_bad.replace(
        "          retention-days: 90\n",
        "          include-hidden-files: true\n          retention-days: 90\n")
    check("hidden path with include-hidden-files passes",
          not check_hidden_artifacts("f.yml", hidden_ok))

    visible = hidden_bad.replace(".bench-results.json", "dist-newstyle/out.txt")
    check("visible path is not flagged", not check_hidden_artifacts("f.yml", visible))

    multiline = (
        "      - uses: actions/upload-artifact@v7\n"
        "        with:\n"
        "          path: |\n"
        "            normal.txt\n"
        "            .hidden.json\n"
    )
    check("hidden entry inside a `path: |` block is flagged",
          check_hidden_artifacts("f.yml", multiline))

    check("component classifier: dotfile is hidden", is_hidden_path(".bench-results.json"))
    check("component classifier: ./x is not hidden", not is_hidden_path("./x/y.txt"))
    check("component classifier: nested dotdir is hidden", is_hidden_path("a/.b/c"))

    good_retro = (
        "on:\n  schedule:\n    - cron: '0 6 * * 1'\n  workflow_dispatch:\n"
        "jobs:\n  d:\n    steps:\n"
        "      - run: ./dev retrospect | tee retrospect-digest.md\n"
        "      - run: cat retrospect-digest.md >> \"$GITHUB_STEP_SUMMARY\"\n"
        "      - uses: actions/upload-artifact@v7\n        with:\n"
        "          name: d\n          path: retrospect-digest.md\n"
    )
    check("well-wired retrospect passes", not check_retrospect("retrospect.yml", good_retro))
    check("missing workflow_dispatch is flagged",
          check_retrospect("retrospect.yml", good_retro.replace("  workflow_dispatch:\n", "")))
    check("a git push is flagged",
          check_retrospect("retrospect.yml", good_retro + "      - run: git push\n"))
    check("writing recommendations is flagged",
          check_retrospect("retrospect.yml",
                           good_retro + "      - run: ./dev retrospect --record '{}'\n"))
    check("banned token inside a comment is NOT flagged",
          not check_retrospect("retrospect.yml",
                               "# it must not git push or write recommendations.jsonl\n"
                               + good_retro))

    # ── codemap-regen.yml security contract ──────────────────────────────────
    pin = "actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0"
    good_cmr = (
        "# Deployment branches and tags: main ONLY (mandatory codemap-publish setup)\n"
        "name: codemap-regen\n"
        "on:\n"
        "  workflow_dispatch:\n"
        "    inputs:\n"
        "      pr:\n"
        "        type: string\n"
        "permissions: {}\n"
        "jobs:\n"
        "  resolve:\n"
        "    permissions:\n"
        "      contents: read\n"
        "      pull-requests: read\n"
        "    steps:\n"
        f"      - uses: {pin}\n"
        "        with:\n"
        "          persist-credentials: false\n"
        "  generate:\n"
        "    needs: resolve\n"
        "    permissions:\n"
        "      contents: read\n"
        "    steps:\n"
        f"      - uses: {pin}\n"
        "        with:\n"
        "          persist-credentials: false\n"
        "      - run: ./dev codemap\n"
        "  publish:\n"
        "    needs: [resolve, generate]\n"
        "    environment: codemap-publish\n"
        "    permissions:\n"
        "      contents: read\n"
        "    steps:\n"
        "      - env:\n"
        "          REF: r\n"
        "        run: |\n"
        "          if [ \"$REF\" != \"refs/heads/main\" ]; then exit 1; fi\n"
        f"      - uses: {pin}\n"
        "        with:\n"
        "          persist-credentials: false\n"
        "      - env:\n"
        "          CODEMAP_PUBLISH_TOKEN: t\n"
        "        run: |\n"
        "          git -C _head -c http.extraHeader=\"Authorization: Basic x\" push url HEAD:refs/heads/b\n"
    )

    def cmr_bad(name, mutated):
        check(name, bool(check_codemap_regen("codemap-regen.yml", mutated)))

    check("well-formed codemap-regen passes",
          not check_codemap_regen("codemap-regen.yml", good_cmr))
    cmr_bad("unpinned action is flagged", good_cmr.replace(f"{pin}", "actions/checkout@v7", 1))
    cmr_bad("pull_request_target is flagged",
            good_cmr.replace("  workflow_dispatch:\n", "  workflow_dispatch:\n  pull_request_target:\n"))
    cmr_bad("secret in the generate job is flagged",
            good_cmr.replace("      - run: ./dev codemap\n",
                             "      - run: echo ${{ secrets.GITHUB_TOKEN }}\n"))
    cmr_bad("publish without the Environment is flagged",
            good_cmr.replace("    environment: codemap-publish\n", ""))
    cmr_bad("fallback PR is flagged",
            good_cmr.replace("push url HEAD:refs/heads/b\n",
                             "push url HEAD:refs/heads/b\n          gh pr create\n"))
    cmr_bad("missing runtime main-ref guard is flagged",
            good_cmr.replace("          if [ \"$REF\" != \"refs/heads/main\" ]; then exit 1; fi\n",
                             "          true\n"))
    cmr_bad("force push is flagged",
            good_cmr.replace("push url HEAD:refs/heads/b", "push --force url HEAD:refs/heads/b"))
    cmr_bad("publish token leaked into generate is flagged",
            good_cmr.replace("      - run: ./dev codemap\n",
                             "      - run: echo $CODEMAP_PUBLISH_TOKEN\n"))
    cmr_bad("publish running ./dev (contributor code) is flagged",
            good_cmr.replace("          git -C _head",
                             "          ./dev codemap\n          git -C _head"))
    cmr_bad("publish checkout persisting credentials is flagged",
            good_cmr.replace(
                "      - env:\n          REF: r\n",
                "      - uses: " + pin + "\n        with:\n          persist-credentials: true\n"
                "      - env:\n          REF: r\n"))
    cmr_bad("missing workflow_dispatch trigger is flagged",
            good_cmr.replace("workflow_dispatch", "repository_dispatch"))
    cmr_bad("missing CODEMAP_PUBLISH_TOKEN in publish is flagged",
            good_cmr.replace("          CODEMAP_PUBLISH_TOKEN: t\n", "          OTHER: t\n"))
    cmr_bad("missing main-only Environment-policy documentation is flagged",
            good_cmr.replace(
                "# Deployment branches and tags: main ONLY (mandatory codemap-publish setup)\n", ""))
    cmr_bad("missing ephemeral-auth (http.extraHeader) is flagged",
            good_cmr.replace('-c http.extraHeader="Authorization: Basic x" ', ""))
    resolve_block = (
        "  resolve:\n"
        "    permissions:\n"
        "      contents: read\n"
        "      pull-requests: read\n"
        "    steps:\n"
        f"      - uses: {pin}\n"
        "        with:\n"
        "          persist-credentials: false\n")
    cmr_bad("missing resolve job is flagged (no PR-metadata pin enforced)",
            good_cmr.replace(resolve_block, ""))
    cmr_bad("generate not depending on resolve is flagged",
            good_cmr.replace("  generate:\n    needs: resolve\n", "  generate:\n"))
    cmr_bad("publish not depending on generate is flagged",
            good_cmr.replace("    needs: [resolve, generate]\n", "    needs: resolve\n"))
    cmr_bad("nested environment property cannot spoof job Environment gating",
            good_cmr.replace("    environment: codemap-publish\n",
                             "    env:\n      environment: codemap-publish\n"))
    cmr_bad("extra generate write permission is flagged",
            good_cmr.replace(
                "  generate:\n    needs: resolve\n    permissions:\n      contents: read\n",
                "  generate:\n    needs: resolve\n    permissions:\n"
                "      contents: read\n      issues: write\n"))
    cmr_bad("an automatic push trigger is flagged",
            good_cmr.replace("  workflow_dispatch:\n", "  workflow_dispatch:\n  push:\n    branches: [main]\n"))
    cmr_bad("a schedule trigger is flagged",
            good_cmr.replace("  workflow_dispatch:\n", "  workflow_dispatch:\n  schedule:\n    - cron: '0 6 * * 1'\n"))
    cmr_bad("comment-spoofed Environment gating is flagged",
            good_cmr.replace("    environment: codemap-publish\n", "    # environment: codemap-publish\n"))
    cmr_bad("comment-spoofed runtime ref guard is flagged",
            good_cmr.replace('          if [ "$REF" != "refs/heads/main" ]; then exit 1; fi\n',
                             "          # refs/heads/main\n          true\n"))
    cmr_bad("indexed-secret access in generate is flagged",
            good_cmr.replace("      - run: ./dev codemap\n",
                             "      - run: echo ${{ secrets['GITHUB_TOKEN'] }}\n"))
    good_gate = (
        "on:\n  pull_request:\n    branches:\n"
        "      - main\n      - integration/neo-monorepo\n"
        "    types: [opened]\n  push:\n    branches:\n      - main\n"
        "jobs:\n  changes:\n    steps:\n      - run: |\n"
        "          PATTERN='^(core/|testbed/|integrations/|nix/)'\n"
    )
    check("well-wired required gate passes", not check_required_gate("test.yml", good_gate))
    check("pull_request branches extracted (block form)",
          pull_request_branches(good_gate) == ["main", "integration/neo-monorepo"])
    check("missing integration base is flagged",
          check_required_gate("test.yml",
                              good_gate.replace("      - integration/neo-monorepo\n", "")))
    check("missing main base is flagged",
          check_required_gate("test.yml", good_gate.replace("      - main\n", "")))
    check("Haskell compiled surface absent from classifier is flagged",
          check_required_gate("test.yml", good_gate.replace("core/|", "")))
    check("no pull_request branches filter is flagged",
          check_required_gate("test.yml",
                              "on:\n  pull_request:\n    types: [opened]\n"
                              "jobs:\n  changes:\n    steps:\n"
                              "      - run: PATTERN='^(core/)'\n"))
    inline_gate = (
        "on:\n  pull_request:\n    branches: [main, integration/neo-monorepo]\n"
        "    paths:\n      - 'x/**'\n"
    )
    check("pull_request branches extracted (inline form)",
          pull_request_branches(inline_gate) == ["main", "integration/neo-monorepo"])
    check("push branches are not mistaken for pull_request branches",
          pull_request_branches("on:\n  push:\n    branches:\n      - main\n") is None)

    # Component gate (neo-ci.yml): must run on arbitrary bases + route neo/**.
    good_component = (
        "on:\n  pull_request:\n    types: [opened, synchronize]\n"
        "  push:\n    branches: [main]\n    paths:\n      - 'neo/**'\n"
        "jobs:\n  changes:\n    steps:\n      - run: |\n"
        "          PATTERN='^(neo/|nix/neo-package\\.nix|flake\\.nix)'\n"
    )
    check("well-wired component gate passes",
          not check_component_gate("neo-ci.yml", good_component))
    check("component gate runs on arbitrary bases (no branches allowlist)",
          pull_request_branches(good_component) is None)
    check("component gate with a base allowlist is flagged (breaks stacked layers)",
          check_component_gate(
              "neo-ci.yml",
              good_component.replace(
                  "  pull_request:\n    types: [opened, synchronize]\n",
                  "  pull_request:\n    branches: [main, integration/neo-monorepo]\n"
                  "    types: [opened, synchronize]\n")))
    check("component gate missing neo/** routing is flagged",
          check_component_gate("neo-ci.yml", good_component.replace("neo/|", "")))

    # ── consumer-contract job (contract 5) ───────────────────────────────────
    cc_block = (
        "  consumer-contract:\n"
        "    needs: changes\n"
        "    if: needs.changes.outputs.contract == 'true'\n"
        "    runs-on: ubuntu-latest\n"
        "    steps:\n"
        "      - uses: actions/checkout@v7.0.0\n"
        "        with:\n"
        "          fetch-depth: 0\n"
        "      - run: ./dev neo-consumer-contract --self-test\n"
        "      - run: ./dev neo-consumer-contract\n"
    )
    good_contract = (
        "on:\n  pull_request:\n    types: [opened]\n"
        "jobs:\n"
        "  changes:\n"
        "    steps:\n      - run: |\n"
        "          PATTERN='^(neo/|nix/neo-package\\.nix)'\n"
        "          CONTRACT='^(neo/|core/|integrations/|nix/neo-package\\.nix|scripts/neo-consumer-contract)'\n"
        + cc_block +
        "  neo-ci-gate:\n"
        "    if: always()\n"
        "    needs: [changes, rust, ide, nix-package, consumer-contract]\n"
        "    steps:\n"
        "      - run: echo ${{ needs.consumer-contract.result }}\n"
    )

    def cc_bad(name_, mutated):
        check(name_, bool(check_consumer_contract("neo-ci.yml", mutated)))

    check("well-wired consumer contract passes",
          not check_consumer_contract("neo-ci.yml", good_contract))
    cc_bad("removing the consumer-contract job is flagged",
           good_contract.replace(cc_block, ""))
    cc_bad("making the contract report-only (continue-on-error) is flagged",
           good_contract.replace(
               "    runs-on: ubuntu-latest\n",
               "    runs-on: ubuntu-latest\n    continue-on-error: true\n"))
    cc_bad("moving the contract off Linux is flagged",
           good_contract.replace("runs-on: ubuntu-latest", "runs-on: macos-latest"))
    cc_bad("a shallow checkout is flagged",
           good_contract.replace("          fetch-depth: 0\n", ""))
    cc_bad("a self-test-only contract (no full run) is flagged",
           good_contract.replace("      - run: ./dev neo-consumer-contract\n", ""))
    cc_bad("dropping the --self-test step is flagged",
           good_contract.replace("      - run: ./dev neo-consumer-contract --self-test\n", ""))
    cc_bad("decoupling the contract from change detection is flagged",
           good_contract.replace("    if: needs.changes.outputs.contract == 'true'\n",
                                 "    if: always()\n"))
    cc_bad("gate not needing the contract is flagged",
           good_contract.replace(
               "    needs: [changes, rust, ide, nix-package, consumer-contract]\n",
               "    needs: [changes, rust, ide, nix-package]\n"))
    cc_bad("gate not evaluating the contract result is flagged",
           good_contract.replace("      - run: echo ${{ needs.consumer-contract.result }}\n",
                                 "      - run: echo done\n"))
    cc_bad("consumer-contract classifier lacking core/ is flagged",
           good_contract.replace("core/|", ""))
    cc_bad("missing consumer-contract classifier is flagged",
           good_contract.replace(
               "          CONTRACT='^(neo/|core/|integrations/|nix/neo-package\\.nix|scripts/neo-consumer-contract)'\n",
               ""))

    print("workflow-check: self-test", "OK" if ok else "FAILED")
    return 0 if ok else 1


def main(argv):
    if argv and argv[0] == "--self-test":
        return self_test()
    if argv:
        print(f"usage: workflow-check [--self-test]  (got {argv!r})", file=sys.stderr)
        return 2
    errs = run()
    if errs:
        print("workflow-check: FAIL", file=sys.stderr)
        for e in errs:
            print(f"  - {e}", file=sys.stderr)
        return 1
    n = len(list(WORKFLOWS.glob("*.yml")))
    print(f"workflow-check: OK — {n} workflows wired correctly")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
