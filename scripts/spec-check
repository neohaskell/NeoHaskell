#!/usr/bin/env python3
"""Contract-delta spec validator (pipeline Phase 5).

Validates docs/changes/*.md — the spec a draft PR opens with and the
maintainer approves at the gate. The template (docs/changes/TEMPLATE.md) is
itself a validated instance, so the template's machine-read parts (header
keys, fence infos, `## section` names, criteria cells) cannot drift from the
validator. (The criteria table's column *labels* are documentation — parsed
positionally, not asserted; design-review records, `*-review.md`, are not
specs and are skipped.)

Checks (all mechanical — a spec that passes is machine-joinable):
  1. filename: NNN-slug.md (3-digit, kebab), TEMPLATE.md exempt
  2. the ```yaml spec``` header block parses; `kind` in the closed enum;
     `touches` non-empty and every ID exists in codemap/capabilities.yaml
     (the closed localization ontology — the mechanical join for test-impact
     and design-review routing)
  3. the ```diff signatures``` contract-delta block exists; every non-empty
     line is `<+|-> <Module>: <entry>` in codemap/signatures vocabulary
  4. honesty cross-check: any `-` line forces `breaking: true`
  5. criteria table: >=1 row, IDs sequential C1..Cn, proving test non-empty,
     level in {unit, integration, acceptance}
  6. `## User impact` section present and non-empty
  7. ADR trigger: breaking / new-dependency / new-capability /
     new-extension-point -> the `## ADR` section must link docs/decisions/

Modes:
  spec-check [files…]         validate (default: all docs/changes/*.md)
  spec-check --plan FILE      emit the mechanical joins as JSON:
                              required design reviews (touches x risk tags)
                              + test-impact globs (touches x tests:)
  spec-check --reviews-pr [BASE]  PR-ready CI gate: every COMMITTED design review
                              (perf) a changed spec routes must have its committed
                              record (NNN-slug.perf-review.md, backlinking the spec)
  spec-check --reviews-local [BASE]  local gate (dev machine, not CI): every
                              LOCAL-ONLY design review (security) a changed spec
                              routes must have its gitignored record on disk —
                              a security review maps attack surface and is never
                              pushed (ADR-0069)
  spec-check --criteria FILE  emit the criteria table as JSON [{id, behavior,
                              test, level}] — a spec-authoring/review aid
  spec-check --criteria-tests [BASE]  PR-ready DoD gate: every criterion in a
                              changed spec must name a proving test that RESOLVES
                              (a real .hurl under testbed/tests, or a *.hs spec
                              module) — a criterion can't cite a test never written
  spec-check --self-test      embedded fixture + mutation coverage (doctor/CI)

Run: ./dev spec-check    CI: .github/workflows/checks.yml `spec` job
(python3 stdlib only — capabilities.yaml is regex-scanned, no pyyaml)
"""

import fnmatch
import json
import os
import re
import shlex
import signal
import subprocess
import sys
import tempfile
from pathlib import Path

sys.dont_write_bytecode = True  # no scripts/__pycache__/ (doctor scans scripts/)
sys.path.insert(0, str(Path(__file__).resolve().parent))
import speclib  # noqa: E402 — shared delta grammar with spec-drift

ROOT = Path(__file__).resolve().parent.parent
CHANGES = ROOT / "docs" / "changes"
CAPABILITIES = ROOT / "codemap" / "capabilities.yaml"
TEST_SURFACES = ROOT / "docs" / "changes" / "test-surfaces.json"

KINDS = {"feature", "bug", "refactor"}
LEVELS = {"unit", "integration", "acceptance"}
FILENAME = re.compile(r"^\d{3}-[a-z0-9][a-z0-9-]*\.md$")
CRITERION_ID = re.compile(r"^C(\d+)$")
ADR_LINK = re.compile(r"decisions/\d{4}-[a-z0-9-]+\.md")
TRIGGER_FLAGS = ("breaking", "new-dependency", "new-capability", "new-extension-point")
LOCATOR_TOKEN = re.compile(r"`([^`]+)`")
LOCATOR_SEPARATOR = re.compile(r"^(?:\s|<br\s*/?>|[,;/])*$", re.IGNORECASE)
HSPEC_LOCATOR = re.compile(r"^hspec:([a-z0-9-]+):([^#]+\.hs)#(.+)$")
SCRIPT_LOCATOR = re.compile(r"^script:([^#]+)#(.*)$")
HURL_LOCATOR = re.compile(r"^hurl:(.+\.hurl)$")
BOUNDARIES = {"none", "postgres:real", "filesystem:real", "subprocess:real", "http:real"}


def is_spec_file(name):
    """A validatable spec in docs/changes/: excludes the README index and
    design-review records (`*-review.md`). TEMPLATE.md IS a validated instance,
    so it stays in."""
    return name != "README.md" and not speclib.is_review_record(name)


def load_capabilities():
    """Regex-scan capabilities.yaml: id -> {risk tags, test globs}.
    Line-based on purpose — the file is CI-gated by codemap/check.py, so the
    shapes scanned here are stable."""
    caps, current = {}, None
    for line in CAPABILITIES.read_text().splitlines():
        m = re.match(r"^\s*-\s+id:\s+(\S+)", line)
        if m:
            current = m.group(1)
            caps[current] = {"security": False, "perf": False, "tests": []}
            continue
        if current is None:
            continue
        if re.match(r"^\s*security-sensitive:\s*true", line):
            caps[current]["security"] = True
        elif re.match(r"^\s*perf-sensitive:\s*true", line):
            caps[current]["perf"] = True
        else:
            m = re.match(r"^\s*tests:\s*\[(.*)\]", line)
            if m:
                caps[current]["tests"] = [g.strip() for g in m.group(1).split(",") if g.strip()]
    return caps


def load_test_surfaces():
    try:
        data = json.loads(TEST_SURFACES.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError(f"invalid test-surface registry: {error}") from error
    if data.get("schema") != 1 or not isinstance(data.get("hspec_suites"), dict) \
            or not isinstance(data.get("boundaries"), list):
        raise ValueError("invalid test-surface registry shape")
    for suite, definition in data["hspec_suites"].items():
        if not re.fullmatch(r"[a-z0-9-]+", suite) or not isinstance(definition, dict) \
                or not isinstance(definition.get("roots"), list) \
                or not definition["roots"] or any(not safe_repo_path(root)
                                                   for root in definition["roots"]):
            raise ValueError(f"invalid hspec suite registry entry `{suite}`")
    seen = set()
    for entry in data["boundaries"]:
        if not isinstance(entry, dict) or entry.get("kind") not in {"hspec", "script"} \
                or not safe_repo_path(str(entry.get("path", ""))) \
                or entry.get("boundary") not in BOUNDARIES:
            raise ValueError("invalid boundary registry entry")
        if entry.get("kind") == "hspec" and (
                not entry.get("fixture")
                or not isinstance(entry.get("expected_examples"), int)
                or entry["expected_examples"] <= 0):
            raise ValueError("hspec boundary entry needs fixture and expected_examples")
        key = (entry.get("kind"), entry.get("suite"), entry.get("path"), entry.get("match"))
        if key in seen:
            raise ValueError("duplicate boundary registry entry")
        seen.add(key)
    return data


def safe_repo_path(raw):
    path = Path(raw)
    return not path.is_absolute() and ".." not in path.parts and str(path) == raw


def parse_locator(raw):
    match = HSPEC_LOCATOR.fullmatch(raw)
    if match:
        suite, path, exact_match = match.groups()
        if not safe_repo_path(path) or not exact_match.strip():
            return None, f"malformed hspec locator `{raw}`"
        return {"kind": "hspec", "suite": suite, "path": path,
                "match": exact_match.strip(), "raw": raw}, None
    match = SCRIPT_LOCATOR.fullmatch(raw)
    if match:
        path, arguments = match.groups()
        if not safe_repo_path(path):
            return None, f"malformed script locator `{raw}`"
        try:
            argv = shlex.split(arguments)
        except ValueError:
            return None, f"malformed script arguments in `{raw}`"
        return {"kind": "script", "path": path, "argv": argv, "raw": raw}, None
    match = HURL_LOCATOR.fullmatch(raw)
    if match:
        path = match.group(1)
        if not safe_repo_path(path):
            return None, f"malformed hurl locator `{raw}`"
        return {"kind": "hurl", "path": path, "raw": raw}, None
    kind = raw.partition(":")[0] or raw
    return None, f"unsupported proving-test locator kind `{kind}` in `{raw}`"


def parse_test_locators(test_cell):
    tokens = LOCATOR_TOKEN.findall(test_cell)
    if not tokens:
        return [], ["names zero structured proving-test locators"]
    remainder = LOCATOR_TOKEN.sub("", test_cell)
    if not LOCATOR_SEPARATOR.fullmatch(remainder):
        return [], ["contains free-form proving-test prose outside locator tokens"]
    locators, errors = [], []
    for token in tokens:
        locator, error = parse_locator(token)
        if error:
            errors.append(error)
        else:
            locators.append(locator)
    raw_locators = [locator["raw"] for locator in locators]
    duplicates = sorted({raw for raw in raw_locators if raw_locators.count(raw) > 1})
    for duplicate in duplicates:
        errors.append(f"duplicates proving-test locator `{duplicate}`")
    return locators, errors


def locator_boundary_entry(locator, surfaces):
    if locator["kind"] == "hurl":
        return {"boundary": "http:real", "fixture": "hurl-http",
                "expected_examples": 1, "match": None}
    for entry in surfaces["boundaries"]:
        if entry.get("kind") != locator["kind"]:
            continue
        if entry.get("suite") is not None and entry.get("suite") != locator.get("suite"):
            continue
        if entry.get("path") != locator["path"]:
            continue
        if locator["kind"] == "hspec" \
                and not fnmatch.fnmatch(locator["match"], entry.get("match", "*")):
            continue
        return entry
    return None


def locator_boundary(locator, surfaces):
    entry = locator_boundary_entry(locator, surfaces)
    return entry.get("boundary") if entry else "none"


def locator_level_errors(locator, level, boundary, surfaces):
    errors = []
    if boundary not in BOUNDARIES:
        errors.append(f"boundary `{boundary}` is not in {sorted(BOUNDARIES)}")
        return errors
    boundary_entry = locator_boundary_entry(locator, surfaces)
    actual_boundary = boundary_entry.get("boundary") if boundary_entry else "none"
    if level == "acceptance":
        if locator["kind"] != "hurl" or boundary != "http:real":
            errors.append("acceptance requires an exact hurl locator and `http:real` boundary")
    elif level == "integration":
        exact_attestation = boundary_entry is not None \
            and boundary_entry.get("fixture") \
            and isinstance(boundary_entry.get("expected_examples"), int) \
            and boundary_entry.get("expected_examples") > 0 \
            and (locator["kind"] != "hspec"
                 or boundary_entry.get("match") == locator.get("match"))
        if boundary == "none" or actual_boundary != boundary or not exact_attestation:
            errors.append(
                f"integration locator is not exactly attested for declared boundary `{boundary}`"
            )
    elif level == "unit":
        if boundary != "none" or actual_boundary != "none":
            errors.append("unit locator cannot claim or use an attested external boundary")
    return errors


def count_hspec_examples(text, exact_match):
    escaped = re.escape(exact_match)
    pattern = re.compile(rf'^\s*(?:it|specify|prop)\s+"{escaped}"(?:\s|$)')
    return sum(1 for line in text.splitlines() if pattern.search(line))


def resolve_locator(locator, root, surfaces):
    path = root / locator["path"]
    if not path.is_file():
        return [f"missing proving-test path `{locator['path']}`"], 0
    if locator["kind"] == "hurl":
        if not locator["path"].startswith("testbed/tests/"):
            return ["hurl locator must name an exact path under `testbed/tests/`"], 0
        return [], 1
    if locator["kind"] == "script":
        if not path.stat().st_mode & 0o111:
            return [f"script locator path is not executable `{locator['path']}`"], 0
        return [], 1
    suite = surfaces["hspec_suites"].get(locator["suite"])
    if suite is None:
        return [f"unknown hspec suite `{locator['suite']}`"], 0
    if not any(locator["path"] == root_path or locator["path"].startswith(root_path + "/")
               for root_path in suite.get("roots", [])):
        return [f"hspec path `{locator['path']}` is not registered for suite "
                f"`{locator['suite']}`"], 0
    selected = count_hspec_examples(path.read_text(), locator["match"])
    if selected == 0:
        return [f"hspec locator selects zero source examples `{locator['raw']}`"], 0
    if selected > 1:
        return [f"hspec locator is ambiguous ({selected} source examples) "
                f"`{locator['raw']}`"], selected
    return [], selected


def locator_command(locator, root):
    if locator["kind"] == "hspec":
        return [str(root / "dev"), "test", locator["match"], locator["suite"]]
    if locator["kind"] == "script":
        return [str(root / locator["path"]), *locator["argv"]]
    return ["hurl", "--test", str(root / locator["path"])]


def fenced_block(text, info):
    """Content of the ```<info>``` fence, or None."""
    m = re.search(rf"```{re.escape(info)}\n(.*?)```", text, re.DOTALL)
    return m.group(1) if m else None


def section(text, title):
    """Body of a `## title` section, or None."""
    m = re.search(rf"^## {re.escape(title)}\n(.*?)(?=^## |\Z)", text, re.DOTALL | re.MULTILINE)
    return m.group(1) if m else None


def parse_header(block):
    """The ```yaml spec``` block is a flat known-shape mapping — parsed
    line-based (stdlib only). Returns (dict, [errors])."""
    header, errs = {}, []
    for raw in block.splitlines():
        # YAML comment = `#` preceded by whitespace (or line start) — a bare
        # split on "#" would truncate `issue: issue#712` to `issue`
        line = re.split(r"(?:^|\s)#", raw, maxsplit=1)[0].rstrip()
        if not line.strip():
            continue
        m = re.match(r"^([a-z-]+):\s*(.+)$", line)
        if not m:
            errs.append(f"header: unparseable line `{raw.strip()}`")
            continue
        key, val = m.group(1), m.group(2).strip()
        if key == "touches":
            lm = re.match(r"^\[(.*)\]$", val)
            if not lm:
                errs.append("header: `touches` must be a [flow, list]")
                continue
            header[key] = [t.strip() for t in lm.group(1).split(",") if t.strip()]
        elif val in ("true", "false"):
            header[key] = val == "true"
        else:
            header[key] = val
    return header, errs


def criteria_cells(text):
    """Raw criterion rows (list of cell-lists) from the `## Criteria` table, or
    None when the section is absent. Shared by validation and `--criteria`."""
    crit = section(text, "Criteria")
    if crit is None:
        return None
    rows = []
    for line in crit.splitlines():
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        # recognize a criterion by its ID cell regardless of width, so a row
        # missing a column reports the real problem, not "no criteria rows"
        if cells and CRITERION_ID.match(cells[0]):
            rows.append(cells)
    return rows


def parse_criteria(text):
    """Machine-readable criteria with typed locator and boundary declarations.
    Malformed rows are omitted here and rejected by check_spec."""
    return [{"id": c[0], "behavior": c[1], "test": c[2], "level": c[3],
             "boundary": c[4]}
            for c in (criteria_cells(text) or []) if len(c) >= 5]


def check_spec(text, name, caps, surfaces=None):
    """Returns [errors] — pure, testable."""
    errs = []
    if surfaces is None:
        surfaces = load_test_surfaces()

    block = fenced_block(text, "yaml spec")
    if block is None:
        return [f"{name}: missing ```yaml spec``` header block"]
    header, header_errs = parse_header(block)
    errs += [f"{name}: {e}" for e in header_errs]

    if not header.get("issue"):
        errs.append(f"{name}: header needs `issue:` (issue#NNN or adhoc:<slug>)")
    if header.get("kind") not in KINDS:
        errs.append(f"{name}: `kind` must be one of {sorted(KINDS)}, got `{header.get('kind')}`")
    touches = header.get("touches", [])
    if not touches:
        errs.append(f"{name}: `touches` must name at least one capability ID")
    for t in touches:
        if t not in caps:
            errs.append(f"{name}: `touches` names unknown capability `{t}` "
                        "(closed list: codemap/capabilities.yaml)")
    for flag in TRIGGER_FLAGS:
        if not isinstance(header.get(flag), bool):
            errs.append(f"{name}: header needs `{flag}: true|false`")

    delta = speclib.delta_block(text)
    if delta is None:
        errs.append(f"{name}: missing ```diff signatures``` contract-delta block "
                    "(empty block = no-API-change promise, still required)")
        delta = ""
    has_removal = False
    for line in delta.splitlines():
        if not line.strip():
            continue
        m = speclib.DELTA_LINE.match(line)
        if not m:
            errs.append(f"{name}: bad contract-delta line `{line.strip()}` "
                        "(want `<+|-> <Module>: <signature>`)")
            continue
        if m.group(1) == "-":
            has_removal = True
    if has_removal and header.get("breaking") is not True:
        errs.append(f"{name}: contract delta removes a signature but `breaking: false` "
                    "— removals ARE breaking (honesty cross-check)")

    rows = criteria_cells(text)
    if rows is None:
        errs.append(f"{name}: missing `## Criteria` section")
    else:
        if not rows:
            errs.append(f"{name}: criteria table needs at least one `| Cn | … |` row")
        for i, cells in enumerate(rows, start=1):
            cid = cells[0]
            if int(CRITERION_ID.match(cid).group(1)) != i:
                errs.append(f"{name}: criteria IDs must be sequential — row {i} is `{cid}`")
            if len(cells) != 5:
                errs.append(f"{name}: {cid} row needs exactly 5 columns "
                            "(ID|Behavior|Proving test|Level|Boundary)")
                continue
            _behavior, test, level, boundary = cells[1], cells[2], cells[3], cells[4]
            locators, locator_errors = parse_test_locators(test)
            errs += [f"{name}: {cid} {error}" for error in locator_errors]
            if level not in LEVELS:
                errs.append(f"{name}: {cid} level `{level}` not in {sorted(LEVELS)} "
                            "(a boundary-crossing behavior must declare integration/acceptance)")
                continue
            for locator in locators:
                errs += [f"{name}: {cid} {error}" for error in
                         locator_level_errors(locator, level, boundary, surfaces)]

    impact = section(text, "User impact")
    if impact is None or not impact.strip():
        errs.append(f"{name}: missing or empty `## User impact` section "
                    "(\"None\" is acceptable; silence is not)")

    triggered = [f for f in TRIGGER_FLAGS if header.get(f) is True]
    if triggered:
        adr = section(text, "ADR")
        if adr is None or not ADR_LINK.search(adr):
            errs.append(f"{name}: ADR trigger fired ({', '.join(triggered)}) but the "
                        "`## ADR` section links no docs/decisions/NNNN-slug.md")

    return errs


def plan_joins(text, caps):
    """The mechanical joins the pipeline consumes: touches -> required design
    reviews (risk tags) + test-impact globs."""
    header, _ = parse_header(fenced_block(text, "yaml spec") or "")
    touches = [t for t in header.get("touches", []) if t in caps]
    reviews = []
    if any(caps[t]["security"] for t in touches):
        reviews.append("security")
    if any(caps[t]["perf"] for t in touches):
        reviews.append("perf")
    globs = sorted({g for t in touches for g in caps[t]["tests"]})
    return {"touches": touches, "design_reviews": reviews, "test_impact_globs": globs}


def review_obligations(text, spec_name, caps):
    """(kind, record filename) pairs a spec's routing requires — one per entry
    in plan_joins' `design_reviews`; empty when routing is empty."""
    reviews = plan_joins(text, caps)["design_reviews"]
    return [(r, speclib.review_record_name(spec_name, r)) for r in reviews]


# Kinds whose record is COMMITTED next to the spec (CI-gated). Security reviews
# are excluded — they are local-only (see speclib.LOCAL_ONLY_REVIEW_KINDS / ADR-0069).
COMMITTED_REVIEW_KINDS = tuple(k for k in speclib.REVIEW_KINDS
                               if k not in speclib.LOCAL_ONLY_REVIEW_KINDS)


def missing_review_records(spec_name, spec_text, caps, record_exists, record_text, kinds):
    """Pure gate core: given callbacks to test a record's existence and read its
    text, return [error strings] for missing or non-backlinking records. `kinds`
    restricts which review kinds this gate enforces — committed kinds and
    local-only (security) kinds are checked by different gates but share this
    core. Callback-driven so the gate is testable without a git checkout."""
    errs = []
    for kind, record_name in review_obligations(spec_text, spec_name, caps):
        if kind not in kinds:
            continue
        if not record_exists(record_name):
            locality = ("kept LOCAL (it is gitignored — a security review maps attack "
                        "surface and must never be pushed; see ADR-0069)"
                        if kind in speclib.LOCAL_ONLY_REVIEW_KINDS
                        else "committed next to the spec")
            errs.append(f"{spec_name}: routes a `{kind}` design review but its record "
                        f"`{record_name}` is missing — run the neohaskell-{kind}"
                        f"-design-review skill; the record must be {locality}")
        elif spec_name not in record_text(record_name):
            errs.append(f"{record_name}: does not backlink its spec `{spec_name}` "
                        "(the record must name the spec it reviews)")
    return errs


def _reviews_gate(base, caps, kinds, label):
    """Review-record gate over the specs this branch changed vs `base`, for the
    given review `kinds`. Returns an exit code (0 honored, 1 missing/unlinked,
    2 bad base). Existence is filesystem-based, so the local-only (security) gate
    finds a gitignored record on the developer's disk while the committed gate
    finds a tracked one."""
    try:
        specs = speclib.changed_specs(ROOT, base)
    except speclib.GitDiffError as e:
        print(f"spec-check: git diff against `{base}` failed — bad base ref? ({e})",
              file=sys.stderr)
        return 2
    specs = [p for p in specs if is_spec_file(p.name) and p.name != "TEMPLATE.md"]
    if not specs:
        print(f"spec-check: no specs changed vs {base} — no {label} review records to check")
        return 0
    errs = []
    for spec in specs:
        if not spec.exists():
            continue  # spec deleted on the branch — nothing to require
        errs += missing_review_records(
            spec.name, spec.read_text(), caps,
            record_exists=lambda n, d=spec.parent: (d / n).exists(),
            record_text=lambda n, d=spec.parent: (d / n).read_text() if (d / n).exists() else "",
            kinds=kinds)
    for e in errs:
        print(f"spec-check: FAIL — {e}", file=sys.stderr)
    if errs:
        return 1
    print(f"spec-check: OK — {label} design-review records present for {len(specs)} changed spec(s)")
    return 0


def reviews_pr(base, caps):
    """PR-ready gate (CI): every COMMITTED design review (perf) a changed spec
    routes has its committed record. Security reviews are local-only and checked
    by `reviews_local` on the developer's machine, never in CI (ADR-0069)."""
    return _reviews_gate(base, caps, COMMITTED_REVIEW_KINDS, "committed")


def reviews_local(base, caps):
    """Local gate (developer machine, not CI): every LOCAL-ONLY design review
    (security) a changed spec routes has its gitignored record present on disk.
    The pipeline runs this before flipping a PR to ready — the security review
    is enforced without ever being pushed."""
    return _reviews_gate(base, caps, speclib.LOCAL_ONLY_REVIEW_KINDS, "local")


# ── criterion-test-exists gate (Phase 6 DoD) ──────────────────────────────────
# "DoD = criteria green at their declared levels" is enforced by (a) the tier
# lint above binding level→test-shape at spec time, (b) the whole `Test` suite
# (all levels incl. the acceptance test-hurl job) green on main, and (c) THIS
# gate: every criterion's named proving test must actually RESOLVE to a file, so
# a criterion can't cite a test that was never written. It does not re-run tests
# post-merge (see AGENTS.md / ADR-0068) — it checks existence, like reviews_pr.

def unresolved_criteria_tests(spec_name, spec_text, root=ROOT, surfaces=None):
    """Resolve every typed locator to an exact repository test surface."""
    if surfaces is None:
        surfaces = load_test_surfaces()
    errs = []
    for criterion in parse_criteria(spec_text):
        locators, locator_errors = parse_test_locators(criterion["test"])
        errs += [f"{spec_name}: {criterion['id']} {error}" for error in locator_errors]
        for locator in locators:
            resolution_errors, _selected = resolve_locator(locator, root, surfaces)
            errs += [f"{spec_name}: {criterion['id']} {error}"
                     for error in resolution_errors]
    return errs


def run_locator_probe(locator, timeout_seconds=120):
    command = locator_command(locator, ROOT)
    environment = os.environ.copy()
    environment["POSTGRES_AVAILABLE"] = "true"
    process = subprocess.Popen(command, cwd=ROOT, text=True, stdout=subprocess.PIPE,
                               stderr=subprocess.STDOUT, env=environment,
                               start_new_session=True)
    try:
        output, _ = process.communicate(timeout=timeout_seconds)
        return process.returncode, output, False
    except subprocess.TimeoutExpired:
        os.killpg(process.pid, signal.SIGKILL)
        output, _ = process.communicate()
        return 124, output, True


def runtime_probe_errors(locator, boundary_entry, runner=run_locator_probe):
    code, output, timed_out = runner(locator)
    if timed_out:
        return [f"runtime locator probe timed out `{locator['raw']}`"]
    summaries = re.findall(r"^(\d+) examples?, (\d+) failures?$", output, re.MULTILINE)
    if code != 0 or len(summaries) != 1:
        return [f"runtime locator probe did not pass cleanly `{locator['raw']}`"]
    selected, failures = (int(value) for value in summaries[0])
    expected = boundary_entry["expected_examples"]
    errors = []
    if selected != expected or failures != 0:
        errors.append(f"runtime locator selected {selected} examples/{failures} failures; "
                      f"expected {expected}/0 `{locator['raw']}`")
    if boundary_entry["fixture"] not in output:
        errors.append(f"runtime locator did not execute fixture `{boundary_entry['fixture']}`")
    return errors


def runtime_report_errors(locator, boundary_entry, report_text):
    passed = re.findall(rf"^\s*{re.escape(locator['match'])}\s+\[✔\]$",
                        report_text, re.MULTILINE)
    errors = []
    if len(passed) != boundary_entry["expected_examples"]:
        errors.append(f"runtime report selected {len(passed)} passing examples; expected "
                      f"{boundary_entry['expected_examples']} `{locator['raw']}`")
    if boundary_entry["fixture"] not in report_text:
        errors.append(f"runtime report omitted fixture `{boundary_entry['fixture']}`")
    return errors


def criteria_runtime_pr(base, runner=run_locator_probe, report_text=None):
    try:
        specs = [path for path in speclib.changed_specs(ROOT, base)
                 if is_spec_file(path.name) and path.name != "TEMPLATE.md" and path.exists()]
    except speclib.GitDiffError as error:
        print(f"spec-check: runtime diff against `{base}` failed ({error})", file=sys.stderr)
        return 2
    surfaces = load_test_surfaces()
    errors = []
    probed = set()
    for spec in specs:
        for criterion in parse_criteria(spec.read_text()):
            if criterion["level"] != "integration":
                continue
            locators, locator_errors = parse_test_locators(criterion["test"])
            errors += [f"{spec.name}: {criterion['id']} {error}" for error in locator_errors]
            for locator in locators:
                if locator["raw"] in probed:
                    continue
                probed.add(locator["raw"])
                entry = locator_boundary_entry(locator, surfaces)
                if entry is None:
                    errors.append(f"{spec.name}: {criterion['id']} has no boundary fixture")
                    continue
                probe_errors = (
                    runtime_report_errors(locator, entry, report_text)
                    if report_text is not None
                    else runtime_probe_errors(locator, entry, runner)
                )
                errors += [f"{spec.name}: {criterion['id']} {error}"
                           for error in probe_errors]
    for error in errors:
        print(f"spec-check: FAIL — {error}", file=sys.stderr)
    if errors:
        return 1
    print(f"spec-check: OK — {len(probed)} integration locator(s) selected exact runtime fixtures")
    return 0


def require_changed_spec(base, changed_lookup=speclib.changed_specs):
    try:
        specs = [path for path in changed_lookup(ROOT, base)
                 if is_spec_file(path.name) and path.name != "TEMPLATE.md"]
    except speclib.GitDiffError as error:
        print(f"spec-check: git diff against `{base}` failed ({error})", file=sys.stderr)
        return 2
    if not specs:
        print("spec-check: FAIL — PR changes no contract-delta spec", file=sys.stderr)
        return 1
    print(f"spec-check: OK — {len(specs)} changed contract-delta spec(s)")
    return 0


def criteria_tests_pr(base):
    """PR-ready gate: every criterion in a changed spec names a proving test that
    RESOLVES. Mirrors reviews_pr. Exit 0 ok / 1 unresolved / 2 bad base."""
    try:
        specs = speclib.changed_specs(ROOT, base)
    except speclib.GitDiffError as e:
        print(f"spec-check: git diff against `{base}` failed — bad base ref? ({e})", file=sys.stderr)
        return 2
    specs = [p for p in specs if is_spec_file(p.name) and p.name != "TEMPLATE.md"]
    if not specs:
        print(f"spec-check: no specs changed vs {base} — no criteria tests to check")
        return 0
    errs = []
    for spec in specs:
        if not spec.exists():
            continue
        errs += unresolved_criteria_tests(spec.name, spec.read_text())
    for e in errs:
        print(f"spec-check: FAIL — {e}", file=sys.stderr)
    if errs:
        return 1
    print(f"spec-check: OK — criteria proving-tests resolve for {len(specs)} changed spec(s)")
    return 0


# ── self-test ────────────────────────────────────────────────────────────────

VALID_FIXTURE = """# Change 001: example

Intent paragraph.

```yaml spec
issue: issue#712
kind: feature
touches: [core-primitives]
breaking: false
new-dependency: false
new-capability: false
new-extension-point: false
```

## Contract delta

```diff signatures
+ Text: slugify :: Text -> Text
```

## Criteria

| ID | Behavior | Proving test | Level | Boundary |
|----|----------|--------------|-------|----------|
| C1 | slugifies | `hspec:nhcore-test-core:core/test/TextSpec.hs#slugifies` | unit | none |
| C2 | rejects empty | `hspec:nhcore-test-core:core/test/TextSpec.hs#rejects empty` | unit | none |

## User impact

None.

## ADR

Not required.
"""


def self_test():
    caps = load_capabilities()
    fails = 0

    def expect(label, text, want_error_containing):
        nonlocal fails
        errs = check_spec(text, "fixture", caps)
        if want_error_containing is None:
            if errs:
                print(f"self-test FAIL {label}: expected valid, got {errs}")
                fails += 1
        elif not any(want_error_containing in e for e in errs):
            print(f"self-test FAIL {label}: no error containing `{want_error_containing}` in {errs}")
            fails += 1

    expect("valid", VALID_FIXTURE, None)
    if require_changed_spec("base", changed_lookup=lambda _root, _base: []) != 1:
        print("self-test FAIL require-changed accepted zero specs")
        fails += 1
    if require_changed_spec("base", changed_lookup=lambda _root, _base: [
            Path("docs/changes/001-x.md")]) != 0:
        print("self-test FAIL require-changed rejected changed spec")
        fails += 1
    # regression: `issue#712` must survive comment stripping (only
    # whitespace-preceded `#` starts a YAML comment)
    header, _ = parse_header("issue: issue#712  # trailing comment")
    if header.get("issue") != "issue#712":
        print(f"self-test FAIL issue-hash: parsed `{header.get('issue')}`, want `issue#712`")
        fails += 1
    expect("bad-kind", VALID_FIXTURE.replace("kind: feature", "kind: epic"), "`kind` must be")
    expect("unknown-capability",
           VALID_FIXTURE.replace("[core-primitives]", "[warp-drive]"), "unknown capability")
    expect("removal-not-breaking",
           VALID_FIXTURE.replace("+ Text: slugify", "- Text: slugify"), "removals ARE breaking")
    expect("triggered-without-adr",
           VALID_FIXTURE.replace("breaking: false", "breaking: true")
                        .replace("+ Text: slugify", "- Text: slugify"), "links no docs/decisions")
    expect("bad-level", VALID_FIXTURE.replace("| unit |", "| mocked |", 1), "not in")
    expect("gap-in-ids", VALID_FIXTURE.replace("| C2 |", "| C7 |"), "sequential")
    expect("no-delta-block",
           re.sub(r"```diff signatures\n.*?```", "", VALID_FIXTURE, flags=re.DOTALL),
           "contract-delta block")
    expect("bad-delta-line",
           VALID_FIXTURE.replace("+ Text: slugify :: Text -> Text", "+ added a function"),
           "bad contract-delta line")
    expect("no-impact",
           VALID_FIXTURE.replace("## User impact\n\nNone.\n", "## User impact\n\n"),
           "User impact")

    criterion_row = "| C1 | slugifies | `hspec:nhcore-test-core:core/test/TextSpec.hs#slugifies` | unit | none |"
    expect("short-criteria-row", VALID_FIXTURE.replace(criterion_row,
           "| C1 | slugifies | `hspec:nhcore-test-core:core/test/TextSpec.hs#slugifies` | unit |"),
           "exactly 5 columns")
    expect("zero-locators", VALID_FIXTURE.replace(
           "`hspec:nhcore-test-core:core/test/TextSpec.hs#slugifies`", "manual QA", 1),
           "zero structured")
    expect("malformed-locator", VALID_FIXTURE.replace(
           "hspec:nhcore-test-core:core/test/TextSpec.hs#slugifies",
           "hspec:nhcore-test-core:core/test/TextSpec.hs", 1), "unsupported")
    expect("unsupported-locator", VALID_FIXTURE.replace(
           "hspec:nhcore-test-core:core/test/TextSpec.hs#slugifies",
           "browser:testbed/tests/x#slugifies", 1), "unsupported")
    expect("duplicate-locator", VALID_FIXTURE.replace(
           "`hspec:nhcore-test-core:core/test/TextSpec.hs#slugifies`",
           "`hspec:nhcore-test-core:core/test/TextSpec.hs#slugifies`<br>"
           "`hspec:nhcore-test-core:core/test/TextSpec.hs#slugifies`", 1), "duplicates")
    expect("free-prose-with-locator", VALID_FIXTURE.replace(
           "`hspec:nhcore-test-core:core/test/TextSpec.hs#slugifies`",
           "manual `hspec:nhcore-test-core:core/test/TextSpec.hs#slugifies`", 1),
           "free-form")
    expect("acceptance-needs-hurl", VALID_FIXTURE.replace(
           criterion_row,
           "| C1 | slugifies | `hspec:nhcore-test-core:core/test/TextSpec.hs#slugifies` | acceptance | http:real |"),
           "acceptance requires")
    expect("unit-cannot-claim-boundary", VALID_FIXTURE.replace(
           "| unit | none |", "| unit | postgres:real |", 1),
           "unit locator cannot")
    expect("acceptance-with-hurl", VALID_FIXTURE.replace(
           criterion_row,
           "| C1 | slugifies | `hurl:testbed/tests/commands/slug.hurl` | acceptance | http:real |"),
           None)

    crit = parse_criteria(VALID_FIXTURE)
    if [c["id"] for c in crit] != ["C1", "C2"] or crit[0]["level"] != "unit" \
            or crit[0]["boundary"] != "none":
        print(f"self-test FAIL parse-criteria: {crit}")
        fails += 1

    with tempfile.TemporaryDirectory() as temp_dir:
        fixture_root = Path(temp_dir)
        (fixture_root / "tests").mkdir()
        spec_path = fixture_root / "tests" / "ExampleSpec.hs"
        spec_path.write_text('it "exact example" \\ctx -> do\n  pass\n')
        (fixture_root / "testbed" / "tests").mkdir(parents=True)
        (fixture_root / "testbed" / "tests" / "example.hurl").write_text("GET http://localhost\n")
        script_path = fixture_root / "scripts" / "example"
        script_path.parent.mkdir()
        script_path.write_text("#!/bin/sh\nexit 0\n")
        script_path.chmod(0o755)
        fixture_surfaces = {
            "schema": 1,
            "hspec_suites": {"fixture-suite": {"roots": ["tests"]}},
            "boundaries": [{"kind": "hspec", "suite": "fixture-suite",
                            "path": "tests/ExampleSpec.hs", "match": "exact example",
                            "boundary": "postgres:real", "fixture": "fake-postgres",
                            "expected_examples": 1}],
        }
        valid_locator, _ = parse_locator(
            "hspec:fixture-suite:tests/ExampleSpec.hs#exact example")
        errors, selected = resolve_locator(valid_locator, fixture_root, fixture_surfaces)
        if errors or selected != 1:
            print(f"self-test FAIL locator-resolves: {errors}, selected={selected}")
            fails += 1
        missing, _ = parse_locator("hspec:fixture-suite:tests/MissingSpec.hs#x")
        if not any("missing" in error for error in resolve_locator(
                missing, fixture_root, fixture_surfaces)[0]):
            print("self-test FAIL locator-missing-path"); fails += 1
        wrong_suite, _ = parse_locator("hspec:wrong:tests/ExampleSpec.hs#exact example")
        if not any("unknown hspec suite" in error for error in resolve_locator(
                wrong_suite, fixture_root, fixture_surfaces)[0]):
            print("self-test FAIL locator-wrong-suite"); fails += 1
        zero, _ = parse_locator("hspec:fixture-suite:tests/ExampleSpec.hs#absent")
        if not any("zero source examples" in error for error in resolve_locator(
                zero, fixture_root, fixture_surfaces)[0]):
            print("self-test FAIL locator-zero-match"); fails += 1
        spec_path.write_text(spec_path.read_text() + 'it "exact example" \\ctx -> do\n  pass\n')
        if not any("ambiguous" in error for error in resolve_locator(
                valid_locator, fixture_root, fixture_surfaces)[0]):
            print("self-test FAIL locator-ambiguous"); fails += 1
        if locator_level_errors(valid_locator, "integration", "filesystem:real",
                                fixture_surfaces) == []:
            print("self-test FAIL locator-incompatible-boundary"); fails += 1
        fixture_entry = fixture_surfaces["boundaries"][0]
        fixture_entry["fixture"] = "fixture-postgres"
        fixture_entry["expected_examples"] = 1
        if runtime_probe_errors(valid_locator, fixture_entry,
                runner=lambda _locator: (0, "fixture-postgres\n1 example, 0 failures\n", False)):
            print("self-test FAIL runtime locator valid probe"); fails += 1
        if not runtime_probe_errors(valid_locator, fixture_entry,
                runner=lambda _locator: (0, "fixture-postgres\n0 examples, 0 failures\n", False)):
            print("self-test FAIL runtime locator zero-match accepted"); fails += 1
        if not runtime_probe_errors(valid_locator, fixture_entry,
                runner=lambda _locator: (0, "1 example, 0 failures\n", False)):
            print("self-test FAIL runtime locator missing fixture accepted"); fails += 1
        if not runtime_probe_errors(valid_locator, fixture_entry,
                runner=lambda _locator: (124, "", True)):
            print("self-test FAIL runtime locator timeout accepted"); fails += 1
        report = "fixture-postgres\n  exact example [✔]\n"
        if runtime_report_errors(valid_locator, fixture_entry, report):
            print("self-test FAIL runtime report valid selection"); fails += 1
        if not runtime_report_errors(valid_locator, fixture_entry,
                                     "fixture-postgres\n"):
            print("self-test FAIL runtime report zero-match accepted"); fails += 1

    joins = plan_joins(
        VALID_FIXTURE.replace("[core-primitives]", "[auth, concurrency]"), caps)
    if joins["design_reviews"] != ["security", "perf"]:
        print(f"self-test FAIL plan-joins: expected both reviews, got {joins}")
        fails += 1
    if not joins["test_impact_globs"]:
        print("self-test FAIL plan-joins: expected test globs for auth+concurrency")
        fails += 1

    # Fix 1: is_spec_file excludes README + review records, keeps specs + template
    for nm, want in (("067-x.md", True), ("TEMPLATE.md", True),
                     ("README.md", False), ("067-x.security-review.md", False)):
        if is_spec_file(nm) is not want:
            print(f"self-test FAIL is_spec_file({nm}): want {want}")
            fails += 1

    # Fix 2: review-record obligations + the split missing/backlink gate (pure, no git)
    auth_spec = VALID_FIXTURE.replace("[core-primitives]", "[auth]")       # security-sensitive
    perf_spec = VALID_FIXTURE.replace("[core-primitives]", "[concurrency]")  # perf-sensitive
    if [n for _, n in review_obligations(auth_spec, "067-x.md", caps)] != \
            ["067-x.security-review.md"]:
        print("self-test FAIL review-obligations: [auth] should owe the security record")
        fails += 1
    if review_obligations(VALID_FIXTURE, "001-x.md", caps):
        print("self-test FAIL review-obligations: untagged spec owes nothing")
        fails += 1
    # security is LOCAL-ONLY: the COMMITTED gate (perf) must NOT require it, so an
    # absent security record never fails --reviews-pr (it is never in CI's tree).
    if missing_review_records("067-x.md", auth_spec, caps, lambda n: False, lambda n: "",
                              kinds=COMMITTED_REVIEW_KINDS):
        print("self-test FAIL review-gate: committed gate must ignore local-only security")
        fails += 1
    # ...but the LOCAL gate DOES require the security record present on disk
    if not missing_review_records("067-x.md", auth_spec, caps, lambda n: False, lambda n: "",
                                  kinds=speclib.LOCAL_ONLY_REVIEW_KINDS):
        print("self-test FAIL review-gate: local gate must require the security record")
        fails += 1
    # a present + backlinked local security record passes the local gate
    if missing_review_records("067-x.md", auth_spec, caps,
                              lambda n: n == "067-x.security-review.md",
                              lambda n: "Spec: docs/changes/067-x.md",
                              kinds=speclib.LOCAL_ONLY_REVIEW_KINDS):
        print("self-test FAIL review-gate: present backlinked security record must pass")
        fails += 1
    # a local security record without a backlink still errors
    if not missing_review_records("067-x.md", auth_spec, caps,
                                  lambda n: True, lambda n: "no reference",
                                  kinds=speclib.LOCAL_ONLY_REVIEW_KINDS):
        print("self-test FAIL review-gate: security record without a backlink must error")
        fails += 1
    # perf reviews ARE committed-gated: the committed gate requires the perf record
    if not missing_review_records("068-y.md", perf_spec, caps, lambda n: False, lambda n: "",
                                  kinds=COMMITTED_REVIEW_KINDS):
        print("self-test FAIL review-gate: committed gate must require the perf record")
        fails += 1

    if fails == 0:
        print("spec-check self-test: OK — fixture mutations, header parsing, plan joins, "
              "spec-file filter, review-record gate, criterion-test-exists gate covered")
    return 1 if fails else 0


def main():
    args = sys.argv[1:]
    if args and args[0] == "--self-test":
        return self_test()

    caps = load_capabilities()

    if args and args[0] == "--plan":
        if len(args) != 2:
            print("usage: spec-check --plan <spec-file>", file=sys.stderr)
            return 2
        spec = Path(args[1])
        if not spec.exists():
            print(f"spec-check: no such spec {spec}", file=sys.stderr)
            return 2
        print(json.dumps(plan_joins(spec.read_text(), caps), indent=2))
        return 0

    if args and args[0] == "--criteria":
        if len(args) != 2:
            print("usage: spec-check --criteria <spec-file>", file=sys.stderr)
            return 2
        spec = Path(args[1])
        if not spec.exists():
            print(f"spec-check: no such spec {spec}", file=sys.stderr)
            return 2
        print(json.dumps(parse_criteria(spec.read_text()), indent=2))
        return 0

    if args and args[0] == "--reviews-pr":
        base = args[1] if len(args) > 1 else "origin/main"
        return reviews_pr(base, caps)

    if args and args[0] == "--reviews-local":
        base = args[1] if len(args) > 1 else "origin/main"
        return reviews_local(base, caps)

    if args and args[0] == "--criteria-tests":
        base = args[1] if len(args) > 1 else "origin/main"
        return criteria_tests_pr(base)

    if args and args[0] == "--require-changed":
        base = args[1] if len(args) > 1 else "origin/main"
        return require_changed_spec(base)

    if args and args[0] == "--criteria-runtime":
        runtime_args = args[1:]
        report_text = None
        if "--report" in runtime_args:
            index = runtime_args.index("--report")
            if index + 1 >= len(runtime_args):
                print("spec-check: --report needs a path", file=sys.stderr)
                return 2
            report_path = Path(runtime_args[index + 1])
            if not report_path.is_file():
                print("spec-check: runtime report is missing", file=sys.stderr)
                return 2
            report_text = report_path.read_text()
            del runtime_args[index:index + 2]
        base = runtime_args[0] if runtime_args else "origin/main"
        return criteria_runtime_pr(base, report_text=report_text)

    files = [Path(a) for a in args] if args else sorted(CHANGES.glob("*.md"))
    files = [p for p in files if is_spec_file(p.name)]
    if not files:
        print("spec-check: no specs to validate")
        return 0

    missing = [p for p in files if not p.exists()]
    if missing:
        for p in missing:
            print(f"spec-check: no such spec {p}", file=sys.stderr)
        return 2

    errors = []
    for path in files:
        if path.name != "TEMPLATE.md" and not FILENAME.match(path.name):
            errors.append(f"{path.name}: filename must be NNN-slug.md (3-digit, kebab-case)")
        errors += check_spec(path.read_text(), path.name, caps)

    for e in errors:
        print(f"spec-check: FAIL — {e}", file=sys.stderr)
    if not errors:
        print(f"spec-check: OK — {len(files)} spec(s) valid")
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
