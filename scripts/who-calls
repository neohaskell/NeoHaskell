#!/usr/bin/env bash
#
# Who references this symbol? The command incrementally indexes only .hie files
# already emitted by normal development. It never starts a build.
#
# Usage: ./dev who-calls <symbol> [module]
#
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "${ROOT}"

self_test() {
  local tmp refresh output code
  tmp="$(mktemp -d)"
  trap 'rm -rf "${tmp}"' RETURN
  refresh="${tmp}/refresh"
  printf '%s\n' '#!/usr/bin/env bash' 'exit 2' > "${refresh}"
  chmod +x "${refresh}"
  set +e
  output="$(WHO_CALLS_REFRESH="${refresh}" WHO_CALLS_DB_PATH="${tmp}/missing" "$0" 'InsertAfter' 2>&1)"
  code=$?
  set -e
  [ "${code}" -eq 2 ] \
    || { echo "who-calls self-test FAIL: cold path exit ${code}, want 2" >&2; return 1; }
  printf '%s\n' "${output}" \
    | grep -Fx 'git grep -n -F -- InsertAfter -- core testbed integrations' >/dev/null \
    || { echo "who-calls self-test FAIL: executable fallback missing" >&2; return 1; }
  if printf '%s\n' "${output}" | grep -q 'cabal build'; then
    echo "who-calls self-test FAIL: cold path suggested a build" >&2
    return 1
  fi

  local warm_refresh fake_hiedb fake_python calls refresh_calls tools
  warm_refresh="${tmp}/warm-refresh"
  fake_hiedb="${tmp}/hiedb"
  fake_python="${tmp}/python3"
  calls="${tmp}/calls"
  refresh_calls="${tmp}/refresh-calls"
  tools="${tmp}/tools"
  printf '%s\n' '#!/usr/bin/env bash' \
    'printf "%s\\n" "${HIEDB_TOOLS_PATH:-missing}" >> "${WHO_CALLS_REFRESH_LOG}"' > "${warm_refresh}"
  printf '%s\n' '#!/usr/bin/env bash' 'printf "%s\\n" "$*" >> "${WHO_CALLS_TEST_LOG}"' > "${fake_hiedb}"
  printf '%s\n' '#!/usr/bin/env bash' 'cat >/dev/null' > "${fake_python}"
  chmod +x "${warm_refresh}" "${fake_hiedb}" "${fake_python}"
  : > "${tmp}/db"
  printf 'test\n%s\n%s\n' "${fake_hiedb}" "${fake_python}" > "${tools}"
  WHO_CALLS_REFRESH="${warm_refresh}" WHO_CALLS_DB_PATH="${tmp}/db" \
    WHO_CALLS_TOOLS_PATH="${tools}" WHO_CALLS_TEST_LOG="${calls}" \
    WHO_CALLS_REFRESH_LOG="${refresh_calls}" \
    "$0" 'execute' 'Service.CommandExecutor.Core'
  grep -Fx -- "-D ${tmp}/db name-refs execute Service.CommandExecutor.Core" "${calls}" >/dev/null \
    || { echo "who-calls self-test FAIL: warm lookup did not use the cached hiedb directly" >&2; return 1; }
  grep -Fx -- "${tools}" "${refresh_calls}" >/dev/null \
    || { echo "who-calls self-test FAIL: refresh did not share the configured tools cache" >&2; return 1; }

  printf '%s\n' '#!/usr/bin/env bash' 'exit 1' > "${fake_hiedb}"
  set +e
  output="$(WHO_CALLS_REFRESH="${warm_refresh}" WHO_CALLS_DB_PATH="${tmp}/db" \
    WHO_CALLS_TOOLS_PATH="${tools}" WHO_CALLS_REFRESH_LOG="${refresh_calls}" \
    "$0" 'broken' 2>&1)"
  code=$?
  set -e
  [ "${code}" -eq 2 ] && printf '%s\n' "${output}" | grep -Fq 'git grep -n -F -- broken' \
    || { echo "who-calls self-test FAIL: corrupt query did not fall back" >&2; return 1; }

  mkfifo "${tmp}/never-written"
  cat > "${fake_hiedb}" <<'SH'
#!/usr/bin/env bash
read -r _line < "${WHO_CALLS_BLOCK_FIFO}"
SH
  chmod +x "${fake_hiedb}"
  set +e
  output="$(WHO_CALLS_REFRESH="${warm_refresh}" WHO_CALLS_DB_PATH="${tmp}/db" \
    WHO_CALLS_TOOLS_PATH="${tools}" WHO_CALLS_REFRESH_LOG="${refresh_calls}" \
    WHO_CALLS_TIMEOUT_SECONDS=0.1 WHO_CALLS_BLOCK_FIFO="${tmp}/never-written" \
    "$0" 'hung' 2>&1)"
  code=$?
  set -e
  [ "${code}" -eq 2 ] && printf '%s\n' "${output}" | grep -Fq 'git grep -n -F -- hung' \
    || { echo "who-calls self-test FAIL: hung query did not time out to fallback" >&2; return 1; }
  echo "who-calls self-test: OK — cold/corrupt/hung paths are bounded fallbacks; warm lookup uses cached tools"
}

if [ "${1:-}" = "--self-test" ]; then
  self_test
  exit $?
fi

NAME="${1:?usage: who-calls <symbol> [module]}"
DB_PATH="${WHO_CALLS_DB_PATH:-${ROOT}/.hiedb}"
TOOLS_PATH="${WHO_CALLS_TOOLS_PATH:-${ROOT}/.hiedb-tools}"
REFRESH="${WHO_CALLS_REFRESH:-${SCRIPT_DIR}/refresh-hiedb}"
QUERY_TIMEOUT_SECONDS="${WHO_CALLS_TIMEOUT_SECONDS:-10}"

fallback() {
  local escaped
  printf -v escaped '%q' "${NAME}"
  echo "who-calls: no usable HIE index; bounded fallback:" >&2
  echo "git grep -n -F -- ${escaped} -- core testbed integrations" >&2
}

if ! HIEDB_DB_PATH="${DB_PATH}" HIEDB_TOOLS_PATH="${TOOLS_PATH}" \
    "${REFRESH}" --if-needed --quiet; then
  fallback
  exit 2
fi
if [ ! -f "${DB_PATH}" ]; then
  fallback
  exit 2
fi

HIEDB_BIN="${WHO_CALLS_HIEDB_BIN:-$(sed -n '2p' "${TOOLS_PATH}" 2>/dev/null || true)}"
PYTHON_BIN="${WHO_CALLS_PYTHON_BIN:-$(sed -n '3p' "${TOOLS_PATH}" 2>/dev/null || true)}"
if [ ! -x "${HIEDB_BIN}" ] || [ ! -x "${PYTHON_BIN}" ]; then
  fallback
  exit 2
fi

# The resolved pinned executables are cached by refresh-hiedb. Every query is
# bounded; corruption, lock errors, and hangs all return the executable fallback.
query_output="$(mktemp)"
trap 'rm -f "${query_output}"' EXIT
query=("${HIEDB_BIN}" -D "${DB_PATH}" name-refs "${NAME}")
if [ $# -ge 2 ]; then query+=("$2"); fi
set +e
python3 - "${QUERY_TIMEOUT_SECONDS}" "${query_output}" "${query[@]}" <<'PY'
import os
import signal
import subprocess
import sys

timeout = float(sys.argv[1])
output_path = sys.argv[2]
process = subprocess.Popen(sys.argv[3:], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           start_new_session=True)
try:
    output, _ = process.communicate(timeout=timeout)
    code = process.returncode
except subprocess.TimeoutExpired:
    os.killpg(process.pid, signal.SIGKILL)
    output, _ = process.communicate()
    code = 124
with open(output_path, "wb") as handle:
    handle.write(output)
raise SystemExit(code)
PY
query_code=$?
set -e
if [ "${query_code}" -ne 0 ]; then
  fallback
  exit 2
fi
if ! "${PYTHON_BIN}" codemap/join-refs.py < "${query_output}"; then
  fallback
  exit 2
fi
