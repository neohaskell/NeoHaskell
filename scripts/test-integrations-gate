#!/usr/bin/env python3
"""Execute the real all-tests runner with owned, offline command fixtures."""

import json
import os
import runpy
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import unittest

ROOT = Path(__file__).resolve().parent.parent
# criteria-runtime evidence, in concatenation order.
REPORTS = ("nhcore-test-core.report", "transport-fixture.report",
           ".nhcore-test-service.report", ".nhintegrations-test.report")


class AllTestsRunner(unittest.TestCase):
    def run_all(self, integrations_status, failing_suite="nhintegrations-test"):
        with tempfile.TemporaryDirectory(prefix="nh-test-all-") as directory:
            work = Path(directory)
            binaries = work / "bin"
            binaries.mkdir()
            log = work / "commands.jsonl"
            command_fixture = binaries / "fixture"
            command_fixture.write_text(
                "#!" + sys.executable + "\n"
                "import json, os, pathlib, sys\n"
                "name = pathlib.Path(sys.argv[0]).name\n"
                "with open(os.environ['FIXTURE_LOG'], 'a') as output:\n"
                "    output.write(json.dumps([name, *sys.argv[1:]]) + '\\n')\n"
                "if name == 'cabal' and sys.argv[1:3] == ['test', os.environ['FAILING_SUITE']]:\n"
                "    raise SystemExit(int(os.environ['INTEGRATIONS_STATUS']))\n"
            )
            command_fixture.chmod(0o755)
            for name in ("cabal", "pg_isready", "hurl", "hlint", "ffmpeg", "python3"):
                (binaries / name).symlink_to(command_fixture.name)
            testbed = work / "testbed" / "scripts"
            testbed.mkdir(parents=True)
            shutil.copy2(command_fixture, testbed / "run-tests.sh")
            environment = dict(os.environ)
            environment.update(
                PATH=str(binaries) + os.pathsep + os.defpath,
                FIXTURE_LOG=str(log),
                INTEGRATIONS_STATUS=str(integrations_status),
                FAILING_SUITE=failing_suite,
            )
            result = subprocess.run(
                ["bash", str(ROOT / "scripts/run-all-tests.sh"), "--require-all"],
                cwd=work, env=environment, text=True, capture_output=True, check=False,
            )
            calls = [json.loads(line) for line in log.read_text().splitlines()]
            return result, calls

    def test_existing_core_failure_control(self):
        result, calls = self.run_all(37, "nhcore-test-core")
        self.assertEqual(result.returncode, 1, result.stdout + result.stderr)
        self.assertIn(["cabal", "test", "nhcore-test-core"], calls)
        self.assertIn(["run-tests.sh"], calls)

    def test_whole_integrations_suite_is_executed(self):
        result, calls = self.run_all(0)
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertEqual(calls.count(["cabal", "test", "nhintegrations-test"]), 1,
                         "the complete nhintegrations-test suite was not executed exactly once")
        self.assertIn(["cabal", "test", "nhcore-test-integration"], calls)
        self.assertIn(["cabal", "test", "nhcore-test-service"], calls)
        self.assertIn(["run-tests.sh"], calls)

    def test_integrations_failure_is_not_skipped(self):
        result, calls = self.run_all(37)
        self.assertEqual(result.returncode, 1,
                         "nhintegrations-test failed but test-all reported success\n" + result.stdout)
        self.assertIn(["cabal", "test", "nhintegrations-test"], calls)
        self.assertIn(["cabal", "test", "nhcore-test-service"], calls)
        self.assertIn(["run-tests.sh"], calls)


class IntegrationWorkflows(unittest.TestCase):
    def assert_linux_suite_required(self, source):
        workflow = runpy.run_path(str(ROOT / "scripts/workflow-check"))
        text = workflow["strip_comments"](source)
        jobs = workflow["job_blocks"](text)
        suite = jobs.get("test-integrations", "")
        self.assertRegex(suite, r"cabal test nhintegrations-test(?:\s|$)")
        self.assertNotIn("--match", suite)
        self.assertNotIn("continue-on-error:", suite)
        self.assertIn("--test-show-details=direct", suite)
        self.assertIn("pipefail", suite)
        self.assertIn("upload-artifact", suite)
        self.assertIn("include-hidden-files: true", suite)
        gate = jobs["ci-gate"]
        self.assertRegex(gate, r"(?m)^    needs:.*\btest-integrations\b")
        self.assertIn("needs.test-integrations.result", gate)
        runtime = jobs.get("criteria-runtime", "")
        self.assertRegex(runtime, r"(?m)^    needs:.*\btest-core\b.*\btest-transport\b"
                                  r".*\btest-service\b.*\btest-integrations\b")
        self.assertIn("cat " + " ".join(REPORTS) + " > .criteria-runtime.report", runtime)
        # Producers stay independent: test-service never waits on test-core.
        self.assertRegex(jobs.get("test-service", ""), r"(?m)^    needs: \[build\]$")
        self.assertRegex(gate, r"(?m)^    needs:.*\btest-transport\b")
        self.assertIn("needs.test-transport.result", gate)
        self.assertEqual(workflow["check_criteria_report"]("test.yml", source), [])
        self.assertIn("--criteria-runtime", runtime)
        self.assertIn("--report .criteria-runtime.report", runtime)
        self.assertIn("needs.criteria-runtime.result", gate)

    def test_linux_suite_is_required(self):
        self.assert_linux_suite_required((ROOT / ".github/workflows/test.yml").read_text())

    def test_linux_gate_negative_controls(self):
        source = (ROOT / ".github/workflows/test.yml").read_text()
        self.assert_linux_suite_required(source)
        changes = {
            "missing job": ("  test-integrations:", "  removed-integrations:"),
            "missing needs": ("test-integration, test-integrations, test-service", "test-integration, test-service"),
            "missing result": ("needs.test-integrations.result", "needs.test-integration.result"),
            "wrong suite": ("cabal test nhintegrations-test", "cabal test nhcore-test-integration"),
            "narrowed suite": ("cabal test nhintegrations-test", "cabal test nhintegrations-test --test-options=--match=Video"),
            "missing detailed report": ("--test-show-details=direct | tee .nhintegrations-test.report", ""),
            "missing combined evidence": (".nhcore-test-service.report .nhintegrations-test.report", ".nhcore-test-service.report"),
            "missing transport evidence": ("transport-fixture.report .nhcore-test-service.report", ".nhcore-test-service.report"),
            "missing core evidence": ("cat nhcore-test-core.report ", "cat "),
            "missing transport needs": ("needs: [test-core, test-transport, test-service", "needs: [test-core, test-service"),
            "missing transport download": ("          name: transport-fixture-report\n      - uses: actions/download-artifact@v8\n        with:\n          name: nhcore-test-service-report",
                                           "          name: nhcore-test-service-report"),
            "transport gate result": ("needs.test-transport.result", "needs.test-core.result"),
            "transport mode missing": ("tls proxy body secure-internal-body public-trust", "tls proxy body public-trust"),
            "transport without pipefail": ("          set -euo pipefail\n          : > transport-fixture.report", "          : > transport-fixture.report"),
            "transport report missing upload": ("          path: transport-fixture.report\n          retention-days: 1\n          if-no-files-found: error",
                                                "          path: transport-fixture.report\n          retention-days: 1\n          if-no-files-found: warn"),
            "service coupled to core": ("  test-service:\n    needs: [build]", "  test-service:\n    needs: [build, test-core]"),
            "empty hidden report": ("include-hidden-files: true", "include-hidden-files: false"),
        }
        for name, (old, new) in changes.items():
            with self.subTest(name=name):
                self.assertIn(old, source)
                with self.assertRaises(AssertionError):
                    self.assert_linux_suite_required(source.replace(old, new))

    def test_combined_report_fails_if_any_suite_report_is_missing(self):
        workflow = runpy.run_path(str(ROOT / "scripts/workflow-check"))
        source = (ROOT / ".github/workflows/test.yml").read_text()
        runtime = workflow["job_blocks"](workflow["strip_comments"](source))["criteria-runtime"]
        concatenate = next(line.strip() for line in runtime.splitlines() if line.strip().startswith("cat "))
        self.assertEqual(concatenate, "cat " + " ".join(REPORTS) + " > .criteria-runtime.report")
        reports = REPORTS
        for missing in (None, *reports):
            with self.subTest(missing=missing), tempfile.TemporaryDirectory(prefix="nh-reports-") as directory:
                work = Path(directory)
                for report in reports:
                    if report != missing:
                        (work / report).write_text(report + "\n")
                result = subprocess.run(["bash", "-euo", "pipefail", "-c", concatenate],
                                        cwd=work, text=True, capture_output=True, check=False)
                if missing is None:
                    self.assertEqual(result.returncode, 0, result.stderr)
                    self.assertEqual((work / ".criteria-runtime.report").read_text(),
                                     "".join(report + "\n" for report in reports))
                else:
                    self.assertNotEqual(result.returncode, 0, "missing suite report was silently accepted")

    def test_macos_matrix_runs_whole_suite(self):
        workflow = runpy.run_path(str(ROOT / "scripts/workflow-check"))
        text = workflow["strip_comments"]((ROOT / ".github/workflows/test-macos.yml").read_text())
        jobs = workflow["job_blocks"](text)
        job = jobs["tests-macos"]
        self.assertRegex(job, r"(?m)^\s+- test-suite: nhintegrations-test\s*$")
        self.assertIn("cabal test ${{ matrix.test-suite }}", job)
        self.assertIn('"integrations/**"', workflow["_on_block"](text))
        self.assertIn('".github/workflows/**"', workflow["_on_block"](text))


class GateRegistration(unittest.TestCase):
    GATE_SCRIPTS = ("IntegrationsGateSpec.hs", "test-integrations-gate", "test-integrations-gate-red")

    def test_gate_scripts_are_doctor_exempted_with_reasons(self):
        # Parsed statically: doctor runs workflow-check, which runs this suite.
        doctor = (ROOT / "scripts/doctor").read_text()
        block = re.search(r"(?ms)^EXEMPT_NAMES=\((.*?)^\)", doctor).group(1)
        reasons = dict(re.findall(r'^\s*"([^":]+):([^"]+)"\s*$', block, re.M))
        for name in self.GATE_SCRIPTS:
            with self.subTest(script=name):
                self.assertTrue((ROOT / "scripts" / name).is_file())
                self.assertTrue(reasons.get(name, "").strip(),
                                f"scripts/{name} has no reasoned doctor exemption")

    def test_checks_workflow_runs_gate_suite_directly(self):
        workflow = runpy.run_path(str(ROOT / "scripts/workflow-check"))
        text = workflow["strip_comments"]((ROOT / ".github/workflows/checks.yml").read_text())
        doctor_job = workflow["job_blocks"](text)["doctor"]
        self.assertRegex(doctor_job, r"(?m)^\s+- run: python3 scripts/test-integrations-gate\s*$")

    def test_integration_runtime_fixtures_are_printed_by_hspec(self):
        surfaces = json.loads((ROOT / "docs/changes/test-surfaces.json").read_text())
        entries = [entry for entry in surfaces["boundaries"]
                   if entry.get("suite") == "nhintegrations-test" and entry.get("fixture")]
        self.assertTrue(entries)
        for entry in entries:
            with self.subTest(match=entry["match"]):
                source = (ROOT / entry["path"]).read_text()
                labels = re.findall(r'\b(?:describe|it)\s+"([^"]*)"', source)
                prefixes = [prefix.strip() for prefix in re.findall(
                    r'\[fmt\|fixture: ([^#|]*)', source) if prefix.strip()]
                self.assertTrue(any(entry["fixture"] in label for label in labels)
                                or any(entry["fixture"].startswith(prefix) for prefix in prefixes),
                                f"no describe/it label or fixture print emits `{entry['fixture']}`")


if __name__ == "__main__":
    unittest.main()
