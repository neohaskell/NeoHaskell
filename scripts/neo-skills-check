#!/usr/bin/env python3
"""Validate the Neo CLI (`neo/**`) agent-guidance layer.

The `neo/` tree is the imported Rust Neo CLI. Its agent guidance is a small set
of prose files (root `AGENTS.md` routing, `neo/AGENTS.md`, `neo/CLAUDE.md`) plus
the discoverable `neo-cli-*` skills. Prose drifts silently; this check is the
executable regression that keeps it honest.

Contract (governing rule: no doc without a gate):
  1. MISSING SKILLS — every required `neo-cli-*` skill exists with a parseable
     frontmatter whose `name:` matches its directory and whose `description:` is
     non-trivial. Every `.claude/skills/*/SKILL.md` (not just the neo ones) must
     have a valid name+description.
  2. STALE DELETED-FILE REFS — no active agent-guidance file may reference the
     retired standalone Ralph-loop assets (STATE.md, NEXT_STEP.md,
     IMPLEMENTATION_PLAN.md, ralph.sh). They were deleted; a reference is a lie.
  3. ROUTING DRIFT — root `AGENTS.md` routes `neo/**` to `neo/AGENTS.md` and
     names every `neo-cli-*` skill; `neo/AGENTS.md` cross-references those skills;
     `neo/CLAUDE.md` points at `neo/AGENTS.md`.
  4. ONE SOURCE OF TRUTH — the consolidated nested skills must not linger under
     `neo/.claude/skills/` (they now live at repo-root as `neo-cli-*`).
  5. CROSS-REF INTEGRITY — every `neo-cli-<x>` token mentioned in any active
     guidance file resolves to a real skill directory (no typos / dangling refs).

Run:  ./dev neo-skills-check              CI: via ./dev doctor (seconds, no nix)
      ./dev neo-skills-check --self-test  fixture coverage (doctor/CI)

Exit 0 = the layer is consistent; exit 1 = drift (precise diff on stderr).
"""

import re
import sys
import tempfile
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent

# The skills a fresh agent needs to locate, modify, test and verify `neo/**`.
REQUIRED_SKILLS = (
    "neo-cli-localizer",
    "neo-cli-implementer",
    "neo-cli-testing",
    "neo-cli-ide",
)

# Standalone planning/state assets deleted with the import. A live reference to
# any of these in agent guidance sends a fresh agent chasing a missing file.
BANNED_REFS = ("STATE.md", "NEXT_STEP.md", "IMPLEMENTATION_PLAN.md", "ralph.sh")

# Nested skills that were folded into the root `neo-cli-*` skills. They must not
# survive under neo/.claude/skills — two copies is two sources of truth.
CONSOLIDATED_NESTED = (
    "running-neo-tests",
    "error-messages-instruct-llms",
    "critique-ide-screen",
)

SKILL_REF_RE = re.compile(r"neo-cli-[a-z0-9-]+")


def parse_frontmatter(text):
    """Return the {key: value} of a leading `---` YAML-ish frontmatter block, or
    None if the file has no frontmatter. Only simple `key: value` scalars are
    read — enough for `name:` and `description:`."""
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        return None
    fm = {}
    for line in lines[1:]:
        if line.strip() == "---":
            return fm
        m = re.match(r"^([A-Za-z0-9_-]+):\s*(.*)$", line)
        if m:
            fm[m.group(1)] = m.group(2).strip()
    return None  # unterminated frontmatter


def active_guidance_files(root):
    """The set of files that constitute live Neo CLI agent guidance."""
    candidates = [
        root / "AGENTS.md",
        root / "CLAUDE.md",
        root / "neo" / "AGENTS.md",
        root / "neo" / "CLAUDE.md",
    ]
    candidates.extend(sorted((root / ".claude" / "skills").glob("*/SKILL.md")))
    nested = root / "neo" / ".claude" / "skills"
    if nested.is_dir():
        candidates.extend(sorted(nested.glob("*/SKILL.md")))
    return [p for p in candidates if p.is_file()]


def read(path):
    return path.read_text(encoding="utf-8")


def check(root):
    """Validate the guidance layer rooted at `root`. Returns a list of errors."""
    errors = []
    skills_dir = root / ".claude" / "skills"

    # --- 1a. Every skill's frontmatter is valid (name matches dir + description).
    known_skills = set()
    for skill_md in sorted(skills_dir.glob("*/SKILL.md")):
        dir_name = skill_md.parent.name
        known_skills.add(dir_name)
        fm = parse_frontmatter(read(skill_md))
        if fm is None:
            errors.append(f"{skill_md.relative_to(root)}: missing or unterminated `---` frontmatter")
            continue
        name = fm.get("name", "")
        desc = fm.get("description", "")
        if name != dir_name:
            errors.append(
                f"{skill_md.relative_to(root)}: frontmatter name `{name or '(none)'}` "
                f"does not match directory `{dir_name}`"
            )
        if len(desc) < 40:
            errors.append(
                f"{skill_md.relative_to(root)}: description missing or too short "
                f"(<40 chars) — write a real 'Use when …' trigger sentence"
            )

    # --- 1b. Every REQUIRED neo-cli skill exists.
    for req in REQUIRED_SKILLS:
        md = skills_dir / req / "SKILL.md"
        if not md.is_file():
            errors.append(
                f".claude/skills/{req}/SKILL.md is missing — the Neo CLI guidance "
                f"layer requires it (localize/implement/test/ide coverage)"
            )

    guidance = active_guidance_files(root)

    # --- 2. No stale references to deleted standalone state/plan files.
    for path in guidance:
        text = read(path)
        for banned in BANNED_REFS:
            if banned in text:
                errors.append(
                    f"{path.relative_to(root)} references deleted file `{banned}` — "
                    f"remove it (STATE/NEXT_STEP/IMPLEMENTATION_PLAN/ralph.sh no longer exist)"
                )

    # --- 3. Routing drift.
    root_agents = root / "AGENTS.md"
    if root_agents.is_file():
        text = read(root_agents)
        if "neo/AGENTS.md" not in text:
            errors.append("AGENTS.md does not route `neo/**` work to `neo/AGENTS.md`")
        if "neo/**" not in text:
            errors.append("AGENTS.md does not scope the Rust override with the `neo/**` path")
        for req in REQUIRED_SKILLS:
            if req not in text:
                errors.append(f"AGENTS.md does not name the `{req}` skill in the neo/** routing block")
    else:
        errors.append("AGENTS.md is missing at repo root")

    neo_agents = root / "neo" / "AGENTS.md"
    if neo_agents.is_file():
        text = read(neo_agents)
        for req in REQUIRED_SKILLS:
            if req not in text:
                errors.append(f"neo/AGENTS.md does not cross-reference the `{req}` skill")
    else:
        errors.append("neo/AGENTS.md is missing")

    neo_claude = root / "neo" / "CLAUDE.md"
    if neo_claude.is_file():
        if "AGENTS.md" not in read(neo_claude):
            errors.append("neo/CLAUDE.md does not point at neo/AGENTS.md")
    else:
        errors.append("neo/CLAUDE.md is missing")

    # --- 4. One source of truth: no lingering consolidated nested skills.
    nested = root / "neo" / ".claude" / "skills"
    for name in CONSOLIDATED_NESTED:
        if (nested / name).exists():
            errors.append(
                f"neo/.claude/skills/{name} still exists — it was consolidated into "
                f"a root `neo-cli-*` skill; delete the nested duplicate"
            )

    # --- 5. Cross-ref integrity: every neo-cli-* mentioned resolves to a skill.
    for path in guidance:
        for ref in sorted(set(SKILL_REF_RE.findall(read(path)))):
            if ref not in known_skills:
                errors.append(
                    f"{path.relative_to(root)} references skill `{ref}` which has no "
                    f".claude/skills/{ref}/ directory (routing typo or missing skill)"
                )

    return errors


# --------------------------------------------------------------------------- #
# Self-test: a good fixture tree passes; each mutation fails for its own reason.
# Runs entirely in temp dirs — never reads or mutates the real repo.
# --------------------------------------------------------------------------- #

def _build_good_tree(root):
    (root / ".claude" / "skills").mkdir(parents=True)
    (root / "neo" / ".claude" / "skills").mkdir(parents=True)

    def skill(name, desc):
        d = root / ".claude" / "skills" / name
        d.mkdir(parents=True)
        (d / "SKILL.md").write_text(
            f"---\nname: {name}\ndescription: {desc}\n---\n\n# {name}\n",
            encoding="utf-8",
        )

    skill("neo-cli-localizer", "Use when routing neo CLI work to the right Rust module or subsystem.")
    skill("neo-cli-implementer", "Use when writing neo CLI Rust code, error and output contracts.")
    skill("neo-cli-testing", "Use when running the neo CLI unit, integration, e2e or smoke layers.")
    skill("neo-cli-ide", "Use when working on the neo CLI IDE frontend and embedded dist sync.")

    (root / "AGENTS.md").write_text(
        "# root\n\nWork under `neo/**` routes to `neo/AGENTS.md`.\n"
        "Skills: neo-cli-localizer, neo-cli-implementer, neo-cli-testing, neo-cli-ide.\n",
        encoding="utf-8",
    )
    (root / "CLAUDE.md").write_text("@AGENTS.md\n", encoding="utf-8")
    (root / "neo" / "AGENTS.md").write_text(
        "# neo\n\nUse neo-cli-localizer, neo-cli-implementer, neo-cli-testing, neo-cli-ide.\n",
        encoding="utf-8",
    )
    (root / "neo" / "CLAUDE.md").write_text("See AGENTS.md.\n", encoding="utf-8")


def self_test():
    fails = 0

    def expect(condition, msg):
        nonlocal fails
        if not condition:
            print(f"neo-skills-check self-test FAIL: {msg}", file=sys.stderr)
            fails += 1

    # Case 0 — a clean tree passes.
    with tempfile.TemporaryDirectory() as td:
        root = Path(td)
        _build_good_tree(root)
        errors = check(root)
        expect(not errors, f"clean tree should pass, got {errors}")

    # Case 1 — a missing required skill fails.
    with tempfile.TemporaryDirectory() as td:
        root = Path(td)
        _build_good_tree(root)
        (root / ".claude" / "skills" / "neo-cli-testing" / "SKILL.md").unlink()
        (root / ".claude" / "skills" / "neo-cli-testing").rmdir()
        errors = check(root)
        expect(any("neo-cli-testing" in e and "missing" in e for e in errors),
               f"missing skill should fail, got {errors}")

    # Case 2 — a stale deleted-file reference fails.
    with tempfile.TemporaryDirectory() as td:
        root = Path(td)
        _build_good_tree(root)
        (root / "neo" / "AGENTS.md").write_text(
            "# neo\n\nStart by reading STATE.md.\n"
            "Use neo-cli-localizer, neo-cli-implementer, neo-cli-testing, neo-cli-ide.\n",
            encoding="utf-8",
        )
        errors = check(root)
        expect(any("STATE.md" in e for e in errors),
               f"stale STATE.md reference should fail, got {errors}")

    # Case 3 — routing drift (root AGENTS.md stops naming a skill) fails.
    with tempfile.TemporaryDirectory() as td:
        root = Path(td)
        _build_good_tree(root)
        (root / "AGENTS.md").write_text(
            "# root\n\nWork under `neo/**` routes to `neo/AGENTS.md`.\n"
            "Skills: neo-cli-localizer, neo-cli-implementer, neo-cli-testing.\n",
            encoding="utf-8",
        )
        errors = check(root)
        expect(any("neo-cli-ide" in e and "routing" in e for e in errors),
               f"root AGENTS.md dropping a skill should fail, got {errors}")

    # Case 4 — a lingering consolidated nested skill fails (one-source-of-truth).
    with tempfile.TemporaryDirectory() as td:
        root = Path(td)
        _build_good_tree(root)
        dup = root / "neo" / ".claude" / "skills" / "running-neo-tests"
        dup.mkdir(parents=True)
        (dup / "SKILL.md").write_text("---\nname: running-neo-tests\ndescription: x\n---\n", encoding="utf-8")
        errors = check(root)
        expect(any("running-neo-tests" in e and "nested" in e for e in errors),
               f"lingering nested duplicate should fail, got {errors}")

    # Case 5 — a dangling neo-cli-* cross-reference fails.
    with tempfile.TemporaryDirectory() as td:
        root = Path(td)
        _build_good_tree(root)
        (root / "neo" / "AGENTS.md").write_text(
            "# neo\n\nUse neo-cli-localizer, neo-cli-implementer, neo-cli-testing, "
            "neo-cli-ide, and neo-cli-nonexistent.\n",
            encoding="utf-8",
        )
        errors = check(root)
        expect(any("neo-cli-nonexistent" in e for e in errors),
               f"dangling skill reference should fail, got {errors}")

    if fails:
        print("neo-skills-check self-test: FAIL", file=sys.stderr)
        return 1
    print("neo-skills-check self-test: OK — clean tree passes; missing-skill, "
          "stale-ref, routing-drift, nested-dup, and dangling-ref mutations each rejected")
    return 0


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if "--self-test" in argv:
        return self_test()

    errors = check(REPO_ROOT)
    if errors:
        print("neo-skills-check: FAIL", file=sys.stderr)
        for e in errors:
            print(f"  - {e}", file=sys.stderr)
        return 1

    n = len(REQUIRED_SKILLS)
    print(f"neo-skills-check: OK — {n} neo-cli-* skills present, routing intact, "
          f"no stale state/plan refs, one source of truth")
    return 0


if __name__ == "__main__":
    sys.exit(main())
