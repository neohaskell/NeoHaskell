{
  "schema_version": 1,
  "rules": [
    {
      "family": "installer-product",
      "paths": [
        "installer/**"
      ]
    },
    {
      "family": "installer-rust",
      "paths": [
        "neo/src/installer/**",
        "neo/src/commands/update.rs",
        "neo/src/commands/uninstall.rs",
        "neo/src/commands/rollback.rs",
        "neo/src/cli.rs",
        "neo/src/app.rs",
        "neo/src/main.rs",
        "neo/src/prereqs.rs",
        "neo/src/config.rs",
        "neo/src/output.rs",
        "neo/src/theme.rs",
        "neo/src/tui/**",
        "neo/Cargo.toml",
        "neo/Cargo.lock",
        "neo/lifecycle/**",
        "neo/src/reconcile/**",
        "neo/assets/templates/**"
      ]
    },
    {
      "family": "neoctl-candidate",
      "paths": [
        "neoctl/**",
        "nix/neoctl-package.nix",
        "core/auth/**",
        "core/config/**",
        "core/core/**",
        "core/concurrency/**",
        "core/decimal/**",
        "core/service/**",
        "core/json/**",
        "core/traits/**",
        "core/system/**",
        "core/http/**",
        "core/meta/**",
        "core/schema/**",
        "core/testlib/**",
        "core/options-parser/**",
        "core/neoql/**",
        "core/parser/**",
        "core/layout/**",
        "integrations/Integration/**"
      ]
    },
    {
      "family": "nix-packaging",
      "paths": [
        "flake.nix",
        "flake.lock",
        "nix/neo-package.nix",
        "neo/flake.nix",
        "neo/flake.lock",
        "cabal.project",
        "nix/hix.nix",
        "core/nhcore.cabal",
        "integrations/nhintegrations.cabal"
      ]
    },
    {
      "family": "embedded-candidate",
      "paths": [
        "neo/starter/**",
        "neo/assets/installer/**"
      ]
    },
    {
      "family": "release-and-cache",
      "paths": [
        ".github/workflows/semantic-release.yml",
        ".github/workflows/neo-release.yml",
        ".github/workflows/cachix-push.yml",
        ".agents/skills/neohaskell-release/references/config.json",
        ".agents/skills/neohaskell-release/references/installer-contract.json",
        ".agents/skills/neohaskell-release/references/required-checks.json",
        ".agents/skills/neohaskell-release/scripts/neo-release",
        ".agents/skills/neohaskell-release/scripts/semantic-release",
        ".agents/skills/neohaskell-release/scripts/cache-prime",
        ".agents/skills/neohaskell-release/scripts/releases/**"
      ]
    }
  ],
  "flake_projection": {
    "path": "flake.nix",
    "excluded_output_attribute": "devShells",
    "excluded_tooling_binding": "ciProject",
    "description": "Exclude development-shell bindings only for an explicitly reviewed root projection and exact package recipe. Unknown structures or changed package dependencies retain all root tokens. Revalidate independence before updating approved shapes.",
    "independent_shapes": [
      {
        "projection_sha256": "4e602d525c08697ede72c05adc5f5c49250dce4c2a4bf20a293a66bfea52b641",
        "dependencies": {
          "nix/neo-package.nix": "668e5f2d1d516c91a1e89179b0e8f5f741970e71a9d8405a02503a9bd824750c",
          "flake.lock": "1effc4277140756e9669e68a4585ae4694e5dabe6bba3d586cf2128a5adf3621"
        },
        "projected_dependencies": {
          "nix/hix.nix": "fabe9af2447fca16c221a18a6b389b04d0996726877167ce0393bcd8b9dae309"
        }
