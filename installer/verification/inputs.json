        "dependencies": {
          "flake.lock": "1effc4277140756e9669e68a4585ae4694e5dabe6bba3d586cf2128a5adf3621"
        },
        "projected_dependencies": {
          "flake.nix": "d22e72ad797872140cf04fb3b310e6ae77e602373b51cf7e3208cf927995b17e"
