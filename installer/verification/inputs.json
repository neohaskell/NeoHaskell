        "projection_sha256": "fabe9af2447fca16c221a18a6b389b04d0996726877167ce0393bcd8b9dae309",
        "dependencies": {
          "flake.lock": "1effc4277140756e9669e68a4585ae4694e5dabe6bba3d586cf2128a5adf3621"
        },
        "projected_dependencies": {
          "flake.nix": "2fd04e0fe4a8b3d4fc976d9b730c45d36736f8b7e3099e9dedd183b136472ac7"
        }
