          "nix/neo-package.nix": "8fc783f2c196e06f40f9173075cb677e5e386f2c240681edf78926def9ddafb9",
          "flake.lock": "1effc4277140756e9669e68a4585ae4694e5dabe6bba3d586cf2128a5adf3621"
        },
        "projected_dependencies": {
          "nix/hix.nix": "fabe9af2447fca16c221a18a6b389b04d0996726877167ce0393bcd8b9dae309"
        }
      }
    ]
  },
  "hix_projection": {
    "path": "nix/hix.nix",
    "description": "Exclude known shell-only settings only for this reviewed package configuration and exact Haskell.nix lock. Compiler, modules, unknown configuration and dependency changes retain all tokens.",
    "independent_shapes": [
      {
        "projection_sha256": "fabe9af2447fca16c221a18a6b389b04d0996726877167ce0393bcd8b9dae309",
        "dependencies": {
          "flake.lock": "1effc4277140756e9669e68a4585ae4694e5dabe6bba3d586cf2128a5adf3621"
