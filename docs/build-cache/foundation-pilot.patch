diff --git a/consumer/Main.hs b/consumer/Main.hs
new file mode 100644
index 0000000..f6329be
--- /dev/null
+++ b/consumer/Main.hs
@@ -0,0 +1,21 @@
+module Main where
+
+import Core
+import "nhcore" Array qualified
+import "nhcore" Result qualified
+import "nhcore" Text qualified
+import Task qualified
+
+main :: IO ()
+main = verify |> Task.runOrPanic
+
+verify :: Task Text ()
+verify = do
+  let values = Array.fromLinkedList [Text.toLower "NEOHASKELL"]
+  let result = Result.Ok values :: Result Text (Array Text)
+  case result of
+    Err error -> Task.throw error
+    Ok actual -> do
+      if Array.get 0 actual == Just "neohaskell"
+        then Task.yield ()
+        else Task.throw "public nhcore reexports changed"
