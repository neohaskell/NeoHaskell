diff --git a/foundation/nhfoundation.cabal b/foundation/nhfoundation.cabal
new file mode 100644
index 0000000..92120fa
--- /dev/null
+++ b/foundation/nhfoundation.cabal
@@ -0,0 +1,88 @@
+cabal-version: 3.4
+name: nhfoundation
+version: 0.10.1
+synopsis: Foundational values and collections for NeoHaskell
+license: Apache-2.0
+license-file: LICENSE
+build-type: Simple
+
+common common_cfg
+  ghc-options:
+    -Wall
+    -Wno-orphans
+    -fno-warn-partial-type-signatures
+    -fno-warn-name-shadowing
+    -Werror
+    -threaded
+
+  build-depends:
+    base,
+    aeson,
+    bytestring,
+    data-default,
+    file-embed,
+    ghc-prim,
+    QuickCheck,
+    string-interpolate,
+    template-haskell,
+    text,
+    text-manipulate,
+    vector,
+
+  default-extensions:
+    ApplicativeDo
+    BlockArguments
+    DataKinds
+    DeriveDataTypeable
+    DerivingStrategies
+    DuplicateRecordFields
+    ImportQualifiedPost
+    ImplicitParams
+    ImpredicativeTypes
+    NamedFieldPuns
+    NoFieldSelectors
+    NoImplicitPrelude
+    OverloadedLabels
+    OverloadedLists
+    OverloadedRecordDot
+    OverloadedStrings
+    PackageImports
+    PartialTypeSignatures
+    QualifiedDo
+    QuasiQuotes
+    StandaloneDeriving
+    Strict
+    TemplateHaskell
+    TypeApplications
+    TypeFamilies
+    TypeOperators
+
+library
+  import: common_cfg
+  default-language: GHC2021
+  hs-source-dirs: core, traits
+  exposed-modules:
+    Applicable
+    Array
+    Basics
+    Bytes.Internal
+    Char
+    Collection
+    Function
+    IO
+    LinkedList
+    Mappable
+    Maybe
+    Result
+    Text
+    Thenable
+    Tuple
+    Unit
+
+test-suite nhfoundation-test
+  import: common_cfg
+  type: exitcode-stdio-1.0
+  main-is: Main.hs
+  hs-source-dirs: test
+  build-depends: nhfoundation, hspec
+  default-language: GHC2021
diff --git a/foundation/test/Main.hs b/foundation/test/Main.hs
new file mode 100644
index 0000000..bad4c6a
--- /dev/null
+++ b/foundation/test/Main.hs
@@ -0,0 +1,22 @@
+module Main where
+
+import Array qualified
+import Basics
+import IO (IO)
+import Maybe (Maybe (..))
+import Result (Result (..))
+import Result qualified
+import Test.Hspec qualified as Hspec
+import Text qualified
+
+main :: IO ()
+main = Hspec.hspec do
+  Hspec.describe "independent foundation" do
+    Hspec.it "maps text without the umbrella" do
+      Text.toLower "NEOHASKELL" |> Hspec.shouldBe "neohaskell"
+    Hspec.it "preserves error values when mapping" do
+      let result = Err "failure" :: Result Text.Text Int
+      Result.map (+ 1) result |> Hspec.shouldBe (Err "failure")
+    Hspec.it "returns Nothing at the empty-array boundary" do
+      let values = Array.empty :: Array.Array Int
+      Array.get 0 values |> Hspec.shouldBe Nothing
