  <diagram id="neohaskell-pipeline" name="Pipeline flow">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1200" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;NeoHaskell · The change pipeline&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=36;fontColor=#263449;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="30" width="1450" height="55" />
        </mxCell>
        <mxCell id="subtitle" value="From request to maintainer merge · Two human gates · Follow the numbered steps" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#263449;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="90" width="1450" height="35" />
        </mxCell>
        <mxCell id="row-one" value="DEFINE THE CONTRACT  →" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#5b6f87;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="140" width="700" height="25" />
        </mxCell>
        <mxCell id="intake-localize" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.2&quot;&gt;01  Intake → localize&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.4;margin-top:10px&quot;&gt;Claim issue; initialize run.&lt;br&gt;Bind capabilities, files and APIs.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="180" width="300" height="140" />
        </mxCell>
        <mxCell id="spec" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.2&quot;&gt;02  Spec + draft PR&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.4;margin-top:10px&quot;&gt;Contract delta + proving tests.&lt;br&gt;Bugs: commit C1 red + receipt.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="450" y="180" width="300" height="140" />
        </mxCell>
        <mxCell id="gate-spec" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.2&quot;&gt;03  GATE 1 · Spec approval&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.4;margin-top:10px&quot;&gt;Wait for explicit maintainer OK.&lt;br&gt;Record approval in local state.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="840" y="180" width="300" height="140" />
        </mxCell>
        <mxCell id="design-plan" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.2&quot;&gt;04  Design-review → plan&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.4;margin-top:10px&quot;&gt;Risk-routed security / perf review.&lt;br&gt;Then order the implementation.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1230" y="180" width="300" height="140" />
        </mxCell>
        <mxCell id="row-two" value="←  PROVE AND IMPLEMENT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#5b6f87;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="450" y="385" width="700" height="25" />
        </mxCell>
        <mxCell id="test-writing" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.2&quot;&gt;05  Test-writing&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.4;margin-top:10px&quot;&gt;Criteria tests fail first.&lt;br&gt;Protect existing expectations.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1230" y="430" width="300" height="140" />
        </mxCell>
        <mxCell id="implement" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.2&quot;&gt;06  Implement&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.4;margin-top:10px&quot;&gt;Copy-adapt; ./dev check loop.&lt;br&gt;Inspect readable control flow.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="840" y="430" width="300" height="140" />
        </mxCell>
        <mxCell id="verify" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.2&quot;&gt;07  Verify&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.4;margin-top:10px&quot;&gt;Criteria → regressions → lint.&lt;br&gt;Contract gates → full acceptance.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="450" y="430" width="300" height="140" />
        </mxCell>
        <mxCell id="pr-ci" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.2&quot;&gt;08  PR → CI / review&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.4;margin-top:10px&quot;&gt;Release notes; validate; mark ready.&lt;br&gt;Fix findings until checks are green.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="430" width="300" height="140" />
        </mxCell>
        <mxCell id="row-three" value="REVIEW AND FINISH  →" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#5b6f87;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="450" y="630" width="700" height="25" />
        </mxCell>
        <mxCell id="gate-ci" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.2&quot;&gt;09  GATE 2 · Final review&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.4;margin-top:10px&quot;&gt;Maintainer approves substantive SHA.&lt;br&gt;Record approved HEAD locally.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="670" width="300" height="140" />
