        <mxCell id="merge" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.2&quot;&gt;12  Maintainer merges&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.4;margin-top:10px&quot;&gt;Merge remains a maintainer action.&lt;br&gt;Post-merge regression guard runs.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
