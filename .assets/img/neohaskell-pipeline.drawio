            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="reviews-note" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.2&quot;&gt;Design review + verification&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.4;margin-top:10px&quot;&gt;&lt;b&gt;Security:&lt;/b&gt; local-only record. &lt;b&gt;Perf:&lt;/b&gt; committed.&lt;br&gt;No risk flags → skip design review.&lt;br&gt;&lt;b&gt;Verify:&lt;/b&gt; declared test levels, impact suites, lint,&lt;br&gt;spec drift, review gates and release fragment.&lt;br&gt;Full suite requires PostgreSQL + Hurl;&lt;br&gt;validate timing evidence; run testbed.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="920" width="470" height="240" />
        </mxCell>
        <mxCell id="resume-note" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.2&quot;&gt;Resume + telemetry&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.4;margin-top:10px&quot;&gt;Resume recorded stage with the binding plan.&lt;br&gt;Each transition: stop → advance → start.&lt;br&gt;Stop activities before waiting for a human;&lt;br&gt;human wait time is outside stage time-boxes.&lt;br&gt;&lt;b&gt;Wrong localization:&lt;/b&gt; park, fix the guiding asset,&lt;br&gt;then re-enter intake with a corrected plan.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="560" y="920" width="470" height="240" />
        </mxCell>
        <mxCell id="failure-note" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.2&quot;&gt;Failure / time-box recovery&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.4;margin-top:10px&quot;&gt;Stage budget breached&lt;br&gt;→ retry once using the same plan&lt;br&gt;→ escalate model tier → park + report.&lt;br&gt;Close parked/failed runs with a class-fix&lt;br&gt;asset delta (or none + reason); archive state.&lt;br&gt;&lt;b&gt;Human approval waits are not failures.&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
