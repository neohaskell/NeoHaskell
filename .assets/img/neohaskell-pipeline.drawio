        <mxCell id="finalize" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.2&quot;&gt;10  Telemetry finalization&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.4;margin-top:10px&quot;&gt;Archive verdict; finish telemetry.&lt;br&gt;One runs.jsonl-only commit.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="450" y="670" width="300" height="140" />
        </mxCell>
        <mxCell id="complete" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:1.2&quot;&gt;11  Final checks → complete&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.4;margin-top:10px&quot;&gt;Wait for checks + CodeRabbit.&lt;br&gt;Verify parent SHA; archive state.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
