          </mxGeometry>
        </mxCell>
        <mxCell id="tail-loop" value="Tail fails / any further substantive delta: reopen → CI / Gate 2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#5b6f87;strokeWidth=2;fontFamily=Helvetica;fontSize=15;fontColor=#35475b;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=1;dashed=1;" edge="1" parent="1" source="complete" target="gate-ci">
