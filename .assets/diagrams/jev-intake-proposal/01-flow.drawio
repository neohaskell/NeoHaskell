          </mxGeometry>
        </mxCell>
        <mxCell id="e16" value="Revalidate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#5b6f87;fontFamily=Helvetica;fontSize=16;fontColor=#263449;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.25;entryY=0.75;dashed=1;" edge="1" parent="1" source="reason" target="usable">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="470" y="1810" />
              <mxPoint x="470" y="1510" />
              <mxPoint x="710" y="1510" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="locked" value="&lt;b style=&quot;font-size:21px&quot;&gt;A typed decision is not permission&lt;/b&gt;&lt;div style=&quot;font-size:17px;line-height:1.35;margin-top:8px&quot;&gt;Your “same branch / same worktree” rule&lt;br&gt;is a locked constraint, not a Jev judgment.&lt;br&gt;&lt;br&gt;Publishing, merging or deleting still needs&lt;br&gt;the authority required by that action.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=18;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#f5f5f5;strokeColor=#b3bdca;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1150" y="165" width="400" height="210" />
        </mxCell>
        <mxCell id="batch-note" value="&lt;b style=&quot;font-size:21px&quot;&gt;Batch independent questions&lt;/b&gt;&lt;div style=&quot;font-size:17px;line-height:1.35;margin-top:8px&quot;&gt;One shared state, separate narrow questions.&lt;br&gt;Speculative questions state their premise.&lt;br&gt;Code reads only the selected branch.&lt;br&gt;&lt;br&gt;Reuse answers while inputs stay unchanged.&lt;br&gt;New evidence needed? Fetch, then call again.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=18;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#f5f5f5;strokeColor=#b3bdca;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1150" y="650" width="400" height="230" />
        </mxCell>
        <mxCell id="score-note" value="&lt;b style=&quot;font-size:21px&quot;&gt;Evidence fit ≠ confidence&lt;/b&gt;&lt;div style=&quot;font-size:17px;line-height:1.35;margin-top:8px&quot;&gt;0 · unrelated or contradicted&lt;br&gt;1 · related vocabulary / dependency&lt;br&gt;2 · partial support; key fact missing&lt;br&gt;3 · directly supports this target&lt;br&gt;&lt;br&gt;Rubric is proposed. Thresholds need data.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=18;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#f5f5f5;strokeColor=#b3bdca;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1150" y="1110" width="400" height="220" />
        </mxCell>
        <mxCell id="checks" value="&lt;b style=&quot;font-size:21px&quot;&gt;The final check is deterministic&lt;/b&gt;&lt;div style=&quot;font-size:17px;line-height:1.35;margin-top:8px&quot;&gt;Known IDs and valid output schema.&lt;br&gt;Required facts exist and remain current.&lt;br&gt;Mixed tasks have a valid sequence.&lt;br&gt;Only relevant uncertainty is considered.&lt;br&gt;Constraints and action authority are intact.&lt;br&gt;&lt;br&gt;Low confidence alone is not a blanket veto.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=18;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#f5f5f5;strokeColor=#b3bdca;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1150" y="1535" width="400" height="240" />
        </mxCell>
