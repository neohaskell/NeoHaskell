        <mxCell id="legend-label-output" value="Typed handoff" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#263449;fillColor=none;strokeColor=none;" vertex="1" parent="1">
