<?xml version='1.0' encoding='utf-8'?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="01-flow" name="Proposed intake · code in control, Jev for meaning">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="2010" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Proposed intake · code in control, Jev for meaning" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=34;fontColor=#263449;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="25" width="1520" height="60" />
        </mxCell>
        <mxCell id="sub" value="REVIEW DRAFT · A design proposal, not implemented behavior. Zero or a small bounded number of Jev calls; LLM fallback only for a named gap." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#263449;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="90" width="1520" height="45" />
        </mxCell>
        <mxCell id="request" value="&lt;b style=&quot;font-size:21px&quot;&gt;Request + existing session&lt;/b&gt;&lt;div style=&quot;font-size:17px;line-height:1.35;margin-top:8px&quot;&gt;Keep explicit task settings and user constraints.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=18;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="580" y="165" width="460" height="85" />
        </mxCell>
        <mxCell id="facts" value="&lt;b style=&quot;font-size:21px&quot;&gt;CODE · Read facts; lock constraints&lt;/b&gt;&lt;div style=&quot;font-size:17px;line-height:1.35;margin-top:8px&quot;&gt;Source: issue / ad hoc / saved session.&lt;br&gt;Branch, worktree, run state, IDs and budget.&lt;br&gt;Explicit pause takes priority over new work.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=18;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="580" y="305" width="460" height="120" />
        </mxCell>
        <mxCell id="explicit" value="&lt;span style=&quot;font-size:12px&quot;&gt;TOOL&lt;/span&gt;&lt;br&gt;&lt;b&gt;Required intent / mode&lt;br&gt;already explicit?&lt;/b&gt;" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#172b42;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;spacing=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="475" width="400" height="150" />
        </mxCell>
        <mxCell id="batch-a" value="&lt;b style=&quot;font-size:21px&quot;&gt;JEV A · Fill unresolved intent slots&lt;/b&gt;&lt;div style=&quot;font-size:17px;line-height:1.35;margin-top:8px&quot;&gt;CHOICE: primary work type and execution mode.&lt;br&gt;NOUL: additional requested actions / mixed work.&lt;br&gt;Never overwrite an explicit setting.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=18;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="580" y="700" width="460" height="125" />
        </mxCell>
        <mxCell id="lookup" value="&lt;b style=&quot;font-size:21px&quot;&gt;CODE · Load the matching playbook&lt;/b&gt;&lt;div style=&quot;font-size:17px;line-height:1.35;margin-top:8px&quot;&gt;Retrieve only its required facts and candidates.&lt;br&gt;Code paths, skill IDs, checkpoints, logs or PRs.&lt;br&gt;Operational tasks need no code localization.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=18;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="580" y="905" width="460" height="130" />
        </mxCell>
        <mxCell id="batch-b" value="&lt;b style=&quot;font-size:21px&quot;&gt;JEV B · Judge retrieved candidates&lt;/b&gt;&lt;div style=&quot;font-size:17px;line-height:1.35;margin-top:8px&quot;&gt;NOUL: does each candidate apply?&lt;br&gt;SCORE: evidence fit for each candidate.&lt;br&gt;CHOICE: known next action or missing field.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=18;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="580" y="1110" width="460" height="130" />
        </mxCell>
        <mxCell id="usable" value="&lt;span style=&quot;font-size:12px&quot;&gt;TOOL&lt;/span&gt;&lt;br&gt;&lt;b&gt;Required fields resolved&lt;br&gt;and checks pass?&lt;/b&gt;" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#172b42;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;spacing=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="1320" width="400" height="150" />
        </mxCell>
        <mxCell id="brief" value="&lt;b style=&quot;font-size:21px&quot;&gt;CODE · Compile an intake record&lt;/b&gt;&lt;div style=&quot;font-size:17px;line-height:1.35;margin-top:8px&quot;&gt;Task + mode + ordered actions + targets.&lt;br&gt;Evidence references, stop rules and budgets.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=18;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="580" y="1555" width="460" height="110" />
        </mxCell>
        <mxCell id="dispatch" value="&lt;b style=&quot;font-size:21px&quot;&gt;CODE · Run a registered playbook&lt;/b&gt;&lt;div style=&quot;font-size:17px;line-height:1.35;margin-top:8px&quot;&gt;Tools handle known steps and state transitions.&lt;br&gt;Invoke an LLM only for a step needing&lt;br&gt;new code, prose, planning or diagnosis.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=18;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="580" y="1745" width="460" height="130" />
        </mxCell>
        <mxCell id="gap" value="&lt;span style=&quot;font-size:12px&quot;&gt;TOOL&lt;/span&gt;&lt;br&gt;&lt;b&gt;What is unresolved?&lt;/b&gt;" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#172b42;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;spacing=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1320" width="350" height="150" />
        </mxCell>
        <mxCell id="fetch" value="&lt;b style=&quot;font-size:21px&quot;&gt;Missing observable evidence&lt;/b&gt;&lt;div style=&quot;font-size:17px;line-height:1.35;margin-top:8px&quot;&gt;Fetch the named source, once within budget.&lt;br&gt;Rejudge only affected questions;&lt;br&gt;if still unresolved, clarify or escalate.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=18;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1100" width="350" height="140" />
        </mxCell>
        <mxCell id="ask" value="&lt;b style=&quot;font-size:21px&quot;&gt;Missing user intent&lt;/b&gt;&lt;div style=&quot;font-size:17px;line-height:1.35;margin-top:8px&quot;&gt;Ask one question naming the choice.&lt;br&gt;Re-enter with the reply and saved state.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=18;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1555" width="350" height="110" />
        </mxCell>
        <mxCell id="reason" value="&lt;b style=&quot;font-size:21px&quot;&gt;Novel interpretation / plan&lt;/b&gt;&lt;div style=&quot;font-size:17px;line-height:1.35;margin-top:8px&quot;&gt;Give an LLM only the unresolved slice.&lt;br&gt;Its proposal returns through the same checks.&lt;br&gt;No expansion of authority.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=18;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#172b42;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1745" width="350" height="130" />
        </mxCell>
