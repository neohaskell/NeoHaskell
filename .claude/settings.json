{
  "autocompact_percentage_override": 75,
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "150000"
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "if FILE=$(printf '%s' \"$CLAUDE_TOOL_INPUT\" | python3 -c 'import json,sys; d=json.load(sys.stdin); fp=d.get(\"file_path\",\"\"); print(fp if fp.endswith(\".hs\") else \"\")' 2>/dev/null) && [ -n \"$FILE\" ]; then \"$CLAUDE_PROJECT_DIR/scripts/with-toolchain\" fourmolu --mode inplace \"$FILE\" 2>/dev/null; fi",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      },
      {
        "hooks": [
          {
            "command": "if echo \"$CLAUDE_TOOL_INPUT\" | grep -qE 'Spec\\.hs\"'; then echo '{\"feedback\": \"Test file modified - remember to run: ./dev test\"}'; fi",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "[ \"$(git branch --show-current)\" != \"main\" ] || { echo '{\"block\": true, \"message\": \"Cannot edit on main branch. Create a feature branch first.\"}' >&2; exit 2; }",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/dialect-guard.py",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/expectation-guard.py",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read(**/*)",
      "Edit",
      "Write",
      "MultiEdit",
      "Bash(./dev:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(find:*)"
    ],
    "deny": [
      "Edit(.claude/allow-expectation-edits)",
      "Write(.claude/allow-expectation-edits)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Read(.git/**)",
      "Write(.git/**)",
      "Read(dist-newstyle/**)",
      "Read(**/dist-newstyle/**)",
      "Read(installer/target/**)",
      "Read(**/target/**)",
      "Read(**/node_modules/**)",
      "Read(website/.astro/**)",
      "Read(website/dist/**)",
      "Read(**/.next/**)",
      "Read(**/build/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.venv/**)"
    ]
  }
}
